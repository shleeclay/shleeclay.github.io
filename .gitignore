node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Astro
.astro/

# upwise 로고 원본 파일 (배포에 불필요 — public/ 에 변환본만 사용)
_upwise/

# 로컬 참고 자료 (Notion export 원본 + 구축 history). 빌드/배포와 무관.
_reference/

# Temp files from image optimization (in case of file-lock failure on Windows)
public/**/*.tmp
*.tmp
# Microsoft Office lock/temp files
~$*

# CV scratch screenshots (underscore-prefixed)
cv/_*.png

# Publication figure inbox — 원본 고해상도(로컬 전용). 최적화본만 public/papers/figures/ 에 커밋.
_figures_inbox/

# 개인용 지원서 정보(비공개)
cv/application_info.xlsx
cv/논문실적_지원용.xlsx
cv/_csv/
