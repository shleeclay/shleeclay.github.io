---
import BaseLayout from "../layouts/BaseLayout.astro";
import L from "../components/L.astro";
import CardPaper from "../components/CardPaper.astro";
import CardPatent from "../components/CardPatent.astro";
import site, {
  publications, conferences, projects, patents,
  teaching, career, education,
  scholarships, certifications, books, langSkills, toolSkills,
  groupByYear, fmtRange, fmtDate,
} from "../data";

const hero    = site.hero;
const about   = site.about;
const contact = site.contact;

// Group time-based items by year (Publications/Patents now render as a grid; Conferences/Teaching stay year-grouped)
const confsByYear  = groupByYear(conferences);
const teachByYear  = groupByYear(teaching);

// Split patents: registered → card grid; application → compact list
const registeredPatents  = patents.filter((p) => p.status === 'registered');
const applicationPatents = patents.filter((p) => p.status === 'application');

// Star renderer (skills levels)
function stars(level: number, max = 5): string {
  return "★".repeat(level) + "☆".repeat(Math.max(0, max - level));
}

// Type label maps
const teachTypeLabels: Record<string, { ko: string; en: string }> = {
  special: { ko: "특강",        en: "Special" },
  univ:    { ko: "대학 강의",   en: "University" },
  online:  { ko: "온라인 강의", en: "Online" },
};

const confTypeLabels: Record<string, string> = {
  oral:   "Oral",
  poster: "Poster",
  video:  "Video",
};
---

<BaseLayout sideBarActiveItemID="about">
  <!-- ───────── HERO ───────── -->
  <section id="top" class="pb-16 pt-8 scroll-mt-12 animate-fade-up">
    <div class="flex flex-col-reverse md:flex-row md:items-center gap-8">
      <div class="flex-1">
        <p class="type-eyebrow text-base-content/70 mb-4" aria-hidden="true">🌿 RESEARCH PORTFOLIO</p>

        <h1 class="type-display-xl mb-5 leading-[0.98]">
          <span data-only="ko">{hero.name.ko}</span>
          <span data-only="en">{hero.name.en}</span>
          <span class="text-primary"> </span>
          <span class="type-headline text-base-content/55 align-baseline">
            <span data-only="ko">{hero.nameSub.ko}</span>
            <span data-only="en">{hero.nameSub.en}</span>
          </span>
        </h1>

        <L tag="p" class="type-headline text-base-content/85 mb-4 max-w-2xl" ko={hero.tagline.ko} en={hero.tagline.en} />
        <L tag="p" class="type-body text-base-content/65 max-w-2xl mb-5" ko={hero.description.ko} en={hero.description.en} />

        <L
          tag="p"
          class="type-body-sm text-base-content/70 mb-7 pl-3 border-l-2"
          ko={hero.affiliation.ko}
          en={hero.affiliation.en}
        />

        <div class="flex flex-wrap gap-3">
          <a href="#publications" class="btn btn-primary gap-2">
            <span data-only="ko">{hero.ctaPrimary.ko}</span>
            <span data-only="en">{hero.ctaPrimary.en}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="#contact" class="btn btn-outline btn-primary">
            <span data-only="ko">{hero.ctaSecondary.ko}</span>
            <span data-only="en">{hero.ctaSecondary.en}</span>
          </a>
        </div>
      </div>

      <!-- Profile image -->
      <div class="shrink-0">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl overflow-hidden ring-1 ring-base-300 shadow-lg">
          <img src="/profile.jpg" alt="Seunghyeon Lee" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── ABOUT ───────── -->
  <section id="about" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{about.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-8" ko={about.title.ko} en={about.title.en} />

    <div class="space-y-4 mb-10 max-w-2xl">
      {about.paragraphs.ko.map((p, i) => (
        <p class="type-body-lg text-base-content/85" data-only="ko">{p}</p>
      ))}
      {about.paragraphs.en.map((p, i) => (
        <p class="type-body-lg text-base-content/85" data-only="en">{p}</p>
      ))}
    </div>

    <!-- Research interests -->
    <L tag="p" class="type-eyebrow text-base-content/65 mb-3" ko={about.interestsLabel.ko} en={about.interestsLabel.en} />
    <div class="flex flex-wrap gap-2 mb-10">
      {about.interests.ko.map((i) => (
        <span class="pill pill-co" data-only="ko">{i}</span>
      ))}
      {about.interests.en.map((i) => (
        <span class="pill pill-co" data-only="en">{i}</span>
      ))}
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {about.stats.map((stat) => (
        <div class="p-4 rounded-2xl bg-base-200/60 border border-base-300/60">
          <p class="type-caption text-base-content/55 mb-1">
            <span data-only="ko">{stat.label.ko}</span>
            <span data-only="en">{stat.label.en}</span>
          </p>
          <p class="text-primary" style="font-size:26px;font-weight:600;line-height:1;">
            {stat.value}
            <span class="text-xs font-normal text-base-content/55 ml-1">
              <span data-only="ko">{stat.unit.ko}</span>
              <span data-only="en">{stat.unit.en}</span>
            </span>
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── EDUCATION ───────── -->
  <section id="education" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.education.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-8" ko={site.education.title.ko} en={site.education.title.en} />

    <div class="space-y-4">
      {education.map((e) => (
        <div class="research-card flex gap-4">
          <!-- Logo slot (square) -->
          <div class="shrink-0 w-14 h-14 md:w-16 md:h-16 rounded-lg bg-base-100/80 border border-base-300/60 flex items-center justify-center overflow-hidden">
            {e.logo ? (
              <img src={e.logo} alt="" class="max-w-[80%] max-h-[80%] object-contain" loading="lazy" />
            ) : (
              <span class="text-base-content/30 text-2xl">🎓</span>
            )}
          </div>
          <div class="flex-1 min-w-0">
            <p class="type-caption text-base-content/55 mb-1">{e.period}</p>
            <h3 class="type-card-title mb-1">
              <span data-only="ko">{e.degree.ko}{' · '}{e.program.ko}</span>
              <span data-only="en">{e.degree.en}{' · '}{e.program.en}</span>
            </h3>
            <p class="type-body-sm text-base-content/70">
              <span data-only="ko">{e.institution.ko}</span>
              <span data-only="en">{e.institution.en}</span>
            </p>
            {e.lab && (
              <p class="type-body-sm text-base-content/60 mt-1">
                <span data-only="ko">{e.lab.ko}{e.advisor ? ` · ${e.advisor.ko}` : ''}</span>
                <span data-only="en">{e.lab.en}{e.advisor ? ` · ${e.advisor.en}` : ''}</span>
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── PUBLICATIONS — card grid (3 cols) ───────── -->
  <section id="publications" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.publications.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-3" ko={site.publications.title.ko} en={site.publications.title.en} />
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.publications.intro.ko} en={site.publications.intro.en} />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {publications.map((p) => <CardPaper paper={p} />)}
    </div>
  </section>

  <!-- ───────── CONFERENCES ───────── -->
  <section id="conferences" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.conferences.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-3" ko={site.conferences.title.ko} en={site.conferences.title.en} />
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.conferences.intro.ko} en={site.conferences.intro.en} />

    <div class="space-y-8 pl-4 border-l-2 border-base-300/40">
      {confsByYear.map(({ year, items }) => (
        <div class="relative">
          <div class="absolute -left-[1.45rem] top-1.5">
            <span class="block w-3 h-3 rounded-full bg-primary ring-4 ring-base-100"></span>
          </div>
          <h3 class="year-head mb-3">{year}</h3>
          <div class="space-y-2">
            {items.map((c) => (
              <div class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 py-2.5 hover:bg-base-200/60 -mx-2 px-2 rounded-md transition-colors">
                <span class="shrink-0 type-body-sm text-base-content/55 whitespace-nowrap w-fit md:w-24 md:pr-3">
                  {fmtDate(c.date)}
                </span>
                <span class={`shrink-0 pill ${c.scope === 'international' ? 'pill-intl' : 'pill-domestic'}`}>
                  {confTypeLabels[c.type] || c.type} · {c.scope === 'international' ? 'Intl.' : 'Domestic'}
                </span>
                <div class="flex-1 min-w-0">
                  <p class="type-body text-base-content leading-snug" style="font-weight:480;">
                    <span data-only="ko">{c.title.ko}</span>
                    <span data-only="en">{c.title.en}</span>
                  </p>
                  <p class="type-body-sm text-base-content/55 mt-0.5">
                    {c.conference}
                    {' · '}
                    <span data-only="ko">{c.venue.ko}</span>
                    <span data-only="en">{c.venue.en}</span>
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── PROJECTS ───────── -->
  <section id="projects" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.projects.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-3" ko={site.projects.title.ko} en={site.projects.title.en} />
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.projects.intro.ko} en={site.projects.intro.en} />

    <div class="space-y-2">
      {projects.map((p) => (
        <div class="flex flex-col md:flex-row md:items-start gap-1 md:gap-4 py-3 px-2 -mx-2 rounded-md hover:bg-base-200/60 transition-colors border-b border-base-300/30">
          <span class="shrink-0 type-body-sm text-base-content/55 whitespace-nowrap w-fit md:w-44">
            {p.period}
          </span>
          <div class="flex-1 min-w-0">
            <p class="type-body text-base-content leading-snug" style="font-weight:480;">
              <span data-only="ko">{p.title.ko}</span>
              <span data-only="en">{p.title.en}</span>
            </p>
            <p class="type-body-sm text-base-content/55 mt-0.5">
              <span data-only="ko">{p.institute.ko}{' · '}{p.role.ko}</span>
              <span data-only="en">{p.institute.en}{' · '}{p.role.en}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── PATENTS — registered = card grid, application = list ───────── -->
  <section id="patents" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.patents.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-3" ko={site.patents.title.ko} en={site.patents.title.en} />
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.patents.intro.ko} en={site.patents.intro.en} />

    <!-- Registered patents — card grid (certificates) -->
    {registeredPatents.length > 0 && (
      <div class="mb-10">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="pill pill-reg">Registered</span>
          <p class="type-caption text-base-content/55">
            <span data-only="ko">등록 특허 · {registeredPatents.length}건</span>
            <span data-only="en">{registeredPatents.length} registered</span>
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {registeredPatents.map((pt) => <CardPatent patent={pt} />)}
        </div>
      </div>
    )}

    <!-- Pending applications — compact list -->
    {applicationPatents.length > 0 && (
      <div>
        <div class="flex items-baseline gap-3 mb-4">
          <span class="pill pill-app">Application</span>
          <p class="type-caption text-base-content/55">
            <span data-only="ko">출원 중 · {applicationPatents.length}건</span>
            <span data-only="en">{applicationPatents.length} pending</span>
          </p>
        </div>
        <div class="space-y-2">
          {applicationPatents.map((pt) => (
            <div class="flex items-start gap-3 py-3 px-3 -mx-2 rounded-lg bg-base-200/40 border border-base-300/40 hover:border-primary/40 transition-colors">
              <span class="shrink-0 type-body-sm text-base-content/55 font-mono w-24 pt-0.5">
                {fmtDate(pt.applicationDate)}
              </span>
              <div class="flex-1 min-w-0">
                <p class="type-body text-base-content leading-snug" style="font-weight:480;">
                  <span data-only="ko">{pt.title.ko}</span>
                  <span data-only="en">{pt.title.en}</span>
                </p>
                <p class="type-body-sm text-base-content/55 mt-0.5">
                  <span class="font-medium">Inventors: </span>{pt.inventors.join(', ')}
                  <span class="mx-1.5 text-base-content/30">·</span>
                  <span data-only="ko">{pt.owner.ko}</span>
                  <span data-only="en">{pt.owner.en}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- ───────── TEACHING ───────── -->
  <section id="teaching" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.teaching.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-3" ko={site.teaching.title.ko} en={site.teaching.title.en} />
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.teaching.intro.ko} en={site.teaching.intro.en} />

    <div class="space-y-8 pl-4 border-l-2 border-base-300/40">
      {teachByYear.map(({ year, items }) => (
        <div class="relative">
          <div class="absolute -left-[1.45rem] top-1.5">
            <span class="block w-3 h-3 rounded-full bg-primary ring-4 ring-base-100"></span>
          </div>
          <h3 class="year-head mb-3">{year}</h3>
          <div class="space-y-2">
            {items.map((t) => {
              const label = teachTypeLabels[t.type] || { ko: t.type, en: t.type };
              return (
                <div class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 py-2 px-2 -mx-2 rounded-md hover:bg-base-200/60 transition-colors">
                  <span class="shrink-0 type-body-sm text-base-content/55 whitespace-nowrap w-fit md:w-36">
                    {fmtRange(t.date, t.dateEnd)}
                  </span>
                  <span class="shrink-0 pill pill-co">
                    <span data-only="ko">{label.ko}</span>
                    <span data-only="en">{label.en}</span>
                  </span>
                  <div class="flex-1 min-w-0">
                    {t.url ? (
                      <a href={t.url} target="_blank" rel="noopener noreferrer" class="type-body text-base-content hover:text-primary" style="font-weight:480;">
                        <span data-only="ko">{t.title.ko}</span>
                        <span data-only="en">{t.title.en}</span>
                      </a>
                    ) : (
                      <p class="type-body text-base-content" style="font-weight:480;">
                        <span data-only="ko">{t.title.ko}</span>
                        <span data-only="en">{t.title.en}</span>
                      </p>
                    )}
                    <p class="type-body-sm text-base-content/55 mt-0.5">
                      <span data-only="ko">{t.host.ko}</span>
                      <span data-only="en">{t.host.en}</span>
                      {t.students > 0 && ` · ${t.students}`}
                      <span data-only="ko">{t.students > 0 ? '명' : ''}</span>
                      <span data-only="en">{t.students > 0 ? ` students` : ''}</span>
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── CAREER ───────── -->
  <section id="career" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.career.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-8" ko={site.career.title.ko} en={site.career.title.en} />

    <div class="space-y-2">
      {career.map((w) => (
        <div class="flex items-start gap-3 py-3 px-2 -mx-2 rounded-md hover:bg-base-200/60 transition-colors border-b border-base-300/30">
          <!-- Logo slot (square) -->
          <div class="shrink-0 w-12 h-12 rounded-lg bg-base-100/80 border border-base-300/60 flex items-center justify-center overflow-hidden mt-0.5">
            {w.logo ? (
              <img src={w.logo} alt="" class="max-w-[80%] max-h-[80%] object-contain" loading="lazy" />
            ) : (
              <span class="text-base-content/30 text-lg">💼</span>
            )}
          </div>

          <div class="flex-1 min-w-0 flex flex-col md:flex-row md:items-baseline gap-1 md:gap-4">
            <span class="shrink-0 type-body-sm text-base-content/55 whitespace-nowrap w-fit md:w-36">
              {w.period}
            </span>
            <span class="shrink-0 pill pill-co">
              <span data-only="ko">{w.type.ko}</span>
              <span data-only="en">{w.type.en}</span>
            </span>
            <div class="flex-1 min-w-0">
              {w.url ? (
                <a href={w.url} target="_blank" rel="noopener noreferrer" class="type-body text-base-content hover:text-primary" style="font-weight:480;">
                  <span data-only="ko">{w.company.ko}</span>
                  <span data-only="en">{w.company.en}</span>
                </a>
              ) : (
                <p class="type-body text-base-content" style="font-weight:480;">
                  <span data-only="ko">{w.company.ko}</span>
                  <span data-only="en">{w.company.en}</span>
                </p>
              )}
              <p class="type-body-sm text-base-content/55 mt-0.5">
                <span data-only="ko">{w.country.ko}</span>
                <span data-only="en">{w.country.en}</span>
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── HONORS (Scholarships + Certifications + Books + Skills) ───────── -->
  <section id="honors" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.honors.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-10" ko={site.honors.title.ko} en={site.honors.title.en} />

    <!-- Scholarships -->
    <L tag="p" class="type-caption text-base-content/65 mb-4" ko={site.honors.scholarships.label.ko} en={site.honors.scholarships.label.en} />
    <div class="space-y-3 mb-10">
      {scholarships.map((s) => (
        <div class="research-card">
          <p class="type-caption text-base-content/55 mb-1">{s.period}</p>
          <p class="type-card-title mb-1">
            <span data-only="ko">{s.name.ko}</span>
            <span data-only="en">{s.name.en}</span>
          </p>
          <p class="type-body-sm text-base-content/65">
            <span data-only="ko">{s.foundation.ko}{' · '}{s.support.ko}</span>
            <span data-only="en">{s.foundation.en}{' · '}{s.support.en}</span>
          </p>
        </div>
      ))}
    </div>

    <!-- Certifications -->
    <L tag="p" class="type-caption text-base-content/65 mb-4" ko={site.honors.certifications.label.ko} en={site.honors.certifications.label.en} />
    <div class="flex flex-wrap gap-2 mb-10">
      {certifications.map((c) => (
        <div class="px-3 py-2 rounded-lg bg-base-200/60 border border-base-300/60">
          <p class="type-body-sm text-base-content" style="font-weight:500;">
            <span data-only="ko">{c.name.ko}</span>
            <span data-only="en">{c.name.en}</span>
          </p>
          {c.date && <p class="type-caption text-base-content/55 mt-0.5">{c.date}</p>}
        </div>
      ))}
    </div>

    <!-- Books -->
    <L tag="p" class="type-caption text-base-content/65 mb-4" ko={site.honors.books.label.ko} en={site.honors.books.label.en} />
    <div class="space-y-3 mb-10">
      {books.map((b) => (
        <div class="research-card">
          <p class="type-card-title mb-1">
            <span data-only="ko">{b.title.ko}</span>
            <span data-only="en">{b.title.en}</span>
          </p>
          <p class="type-body-sm text-base-content/65">
            <span data-only="ko">{b.authors.ko}{' · '}{b.publisher.ko}{' · '}{b.date}</span>
            <span data-only="en">{b.authors.en}{' · '}{b.publisher.en}{' · '}{b.date}</span>
          </p>
          {b.isbn && <p class="type-body-sm text-base-content/45 font-mono mt-0.5">ISBN {b.isbn}</p>}
        </div>
      ))}
    </div>

    <!-- Skills -->
    <L tag="p" class="type-caption text-base-content/65 mb-4" ko={site.honors.skills.label.ko} en={site.honors.skills.label.en} />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
      <!-- Languages -->
      <div>
        <p class="type-body-sm text-base-content/55 mb-2 font-medium" data-only="ko">언어</p>
        <p class="type-body-sm text-base-content/55 mb-2 font-medium" data-only="en">Languages</p>
        <div class="space-y-1.5">
          {langSkills.map((l) => (
            <div class="flex justify-between items-center text-sm">
              <span class="text-base-content/80">
                <span data-only="ko">{l.name.ko}</span>
                <span data-only="en">{l.name.en}</span>
              </span>
              <span class="font-mono text-primary text-[13px] tracking-wider">{stars(l.level, 6)}</span>
            </div>
          ))}
        </div>
      </div>
      <!-- Tools -->
      <div>
        <p class="type-body-sm text-base-content/55 mb-2 font-medium" data-only="ko">도구 · 기술</p>
