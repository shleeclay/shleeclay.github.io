        </a>

        <!-- Google Scholar -->
        {contact.scholarUrl && (
          <a href={contact.scholarUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 p-4 rounded-2xl bg-white/8 hover:bg-white/14 border border-white/15 transition-all">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-white/12 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14l-9-5.4L12 3l9 5.6L12 14zm0 1.1l-7-4.2v3.3c0 2.8 3.1 5.1 7 5.1s7-2.3 7-5.1v-3.3l-7 4.2z"/></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="type-caption mb-0.5">GOOGLE SCHOLAR</p>
              <p class="type-body" style="font-weight:550;">scholar.google.com</p>
            </div>
          </a>
        )}

        <!-- GitHub -->
        {contact.githubUrl && (
          <a href={contact.githubUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 p-4 rounded-2xl bg-white/8 hover:bg-white/14 border border-white/15 transition-all">
            <div class="shrink-0 w-10 h-10 rounded-xl bg-white/12 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2c-3.33.72-4.03-1.6-4.03-1.6-.55-1.4-1.35-1.78-1.35-1.78-1.1-.75.08-.73.08-.73 1.22.09 1.86 1.26 1.86 1.26 1.08 1.86 2.84 1.32 3.53 1 .1-.78.43-1.32.78-1.62-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.1-3.18 0 0 1.02-.32 3.31 1.23a11.5 11.5 0 0 1 6.02 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.6-2.8 5.62-5.47 5.92.42.36.81 1.1.81 2.22v3.29c0 .31.22.69.83.57A12 12 0 0 0 12 .3"/></svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="type-caption mb-0.5">GITHUB</p>
              <p class="type-body" style="font-weight:550;">@shleeclay</p>
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Scroll-spy: highlight current section in sidebar -->
  <script is:inline>
    (function () {
      function init() {
        const allSections = Array.from(document.querySelectorAll('section[id]'));
        const navLinks = document.querySelectorAll('.nav-item');
        if (!allSections.length || !navLinks.length) return;

        const linkById = new Map();
        navLinks.forEach((l) => {
          const href = l.getAttribute('href') || '';
          const id = href.startsWith('#') ? href.slice(1)
                   : href.startsWith('/#') ? href.slice(2)
                   : null;
          if (id) linkById.set(id, l);
        });

        const tracked = allSections.filter((s) => linkById.has(s.id));
        if (!tracked.length) return;

        function setActive(id) {
          navLinks.forEach((l) => l.classList.remove('active-nav-item'));
          const link = linkById.get(id);
          if (link) link.classList.add('active-nav-item');
        }

        function update() {
          const nearBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
          if (nearBottom) {
            setActive(tracked[tracked.length - 1].id);
            return;
          }

          const trigger = window.scrollY + window.innerHeight * 0.30;
          let current = tracked[0];
          for (const s of tracked) {
            const top = s.getBoundingClientRect().top + window.scrollY;
            if (top <= trigger) {
              current = s;
            } else {
              break;
            }
          }
          if (current) setActive(current.id);
        }

        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => { update(); ticking = false; });
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', update);
        update();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>
