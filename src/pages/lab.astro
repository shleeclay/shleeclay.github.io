---
// ───────────────────────────────────────────────────────────────────────────
// PRIVATE PROTOTYPE PAGE — publication 핵심 figure 표시 방식 프로토타입.
//   • 라이브 페이지에 영향 없음 (nav·sitemap·robots 미포함, 어디에도 링크 안 됨)
//   • noindex,nofollow → 검색엔진 색인 안 됨
//   • URL(/lab)을 아는 사람만 접근 (저장소가 public이라 "진짜 비공개"는 아님)
// 샘플 figure = 기존 논문 표지(webp). 실제로는 각 논문의 핵심 그림으로 교체.
// ───────────────────────────────────────────────────────────────────────────

// 실제 데이터 — 2021 Remote Sensing 논문(13 figures). short 캡션(en)은 원본 캡션 변환본.
const F = "/papers/figures/2021_RemoteSens_Feasibility/";
const papers = [
  {
    title: "Real-time UAV wildlife detection",
    meta: "Remote Sensing · 2021 · first author",
    figs: [
      { src: F + "ga.webp",   cap: "Graphical abstract — real-time UAV thermal/RGB wildlife detection" },
      { src: F + "fig1.webp", cap: "Study site overview" },
      { src: F + "fig2.webp", cap: "Detection target categories — isolated · bordering · overlapping · partial" },
      { src: F + "fig3.webp", cap: "Paired capture — thermal (640×512) framed within RGB (4000×3000)" },
      { src: F + "fig4.webp", cap: "Lens distortion correction (focal length)" },
      { src: F + "fig5.webp", cap: "Thermal correction — fur-color artifact" },
      { src: F + "fig6.webp", cap: "Thermal correction — unnatural-signal removal" },
      { src: F + "fig7.webp", cap: "Sobel edge detection & contour extraction" },
      { src: F + "fig8.webp", cap: "Max surface temperature vs. flight height (regression)" },
      { src: F + "fig9.webp", cap: "Detection workflow for all image types" },
      { src: F + "fig10.webp", cap: "Precision & recall computation" },
      { src: F + "fig11.webp", cap: "Detection accuracy by flight height & image type" },
      { src: F + "fig12.webp", cap: "Thermal pixel resolution across 25–275 m altitude" },
    ],
  },
];
---

<!DOCTYPE html>
<html lang="ko" data-theme="shlee-light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>[비공개] Figure 캐러셀 프로토타입 — Seunghyeon Lee</title>
  <style>
    :root { --ink:#0f2218; --muted:#5b6b62; --line:#e3e8e3; --accent:#1f4e3d; }
    * { box-sizing:border-box; }
    body { margin:0; background:#f7f8f6; color:var(--ink);
      font-family:"Pretendard Variable",-apple-system,system-ui,sans-serif; line-height:1.55; }
    .wrap { max-width:1000px; margin:0 auto; padding:48px 24px 120px; }
    h1 { font-size:28px; font-weight:800; letter-spacing:-.02em; margin:0 0 6px; }
    .sub { color:var(--muted); margin:0 0 8px; }
    .warn { background:#fff7e6; border:1px solid #f0d68a; color:#6b5300; font-size:13px;
      padding:10px 14px; border-radius:10px; margin:14px 0 36px; }
    h2 { font-size:13px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--accent); margin:0 0 4px; }
    .lead { font-size:14px; color:var(--muted); margin:0 0 22px; max-width:680px; }
    .lead b { color:var(--ink); }

    /* Publication 카드 그리드 (실제 사이트와 유사) */
    .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
    @media(max-width:760px){ .grid { grid-template-columns:repeat(2,1fr); } }
    @media(max-width:480px){ .grid { grid-template-columns:1fr; } }
    .card { background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden;
      box-shadow:0 1px 2px rgba(0,0,0,.04); display:flex; flex-direction:column;
      transition:transform .25s, box-shadow .25s, border-color .25s; }
    .card:hover { transform:translateY(-4px); box-shadow:0 14px 30px rgba(20,50,35,.14); border-color:#b9cabf; }
    .thumb { position:relative; aspect-ratio:210/297; overflow:hidden; cursor:pointer; background:#eef1ee; }
    .thumb img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .4s; }
    .thumb:hover img { transform:scale(1.04); }
    .fig-badge { position:absolute; top:10px; right:10px; background:rgba(15,34,24,.78); color:#fff;
      font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px; display:flex; align-items:center; gap:5px; }
    .thumb .magnify { position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
      background:rgba(15,34,24,.32); color:#fff; opacity:0; transition:opacity .25s; }
    .thumb:hover .magnify { opacity:1; }
    .body { padding:14px; }
    .body h4 { margin:0 0 4px; font-size:15px; font-weight:700; }
    .body .meta { font-size:12px; color:var(--muted); font-style:italic; }
    .body .row { display:flex; gap:8px; margin-top:12px; }
    .btn-mini { font-size:12px; font-weight:650; padding:5px 11px; border-radius:8px; border:1px solid var(--accent);
      color:var(--accent); background:none; text-decoration:none; display:inline-flex; align-items:center; gap:5px; }
    .btn-mini:hover { background:var(--accent); color:#fff; }

    /* ── Carousel lightbox ── */
    #cz { position:fixed; inset:0; background:rgba(7,14,10,.9); display:none; z-index:60;
      align-items:center; justify-content:center; padding:24px; }
    #cz.on { display:flex; }
    .cz-stage { max-width:1000px; width:100%; display:flex; flex-direction:column; align-items:center; }
    .cz-imgwrap { position:relative; width:100%; display:flex; align-items:center; justify-content:center; }
    #cz-img { max-width:100%; max-height:74vh; border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,.5);
      user-select:none; -webkit-user-drag:none; }
    .cz-cap { color:#e6ece7; font-size:14.5px; margin-top:16px; text-align:center; min-height:1.4em; }
    .cz-count { color:#9fb0a6; font-size:12px; margin-top:6px; letter-spacing:.05em; }
    .cz-nav { position:absolute; top:50%; transform:translateY(-50%); background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.25); color:#fff; width:46px; height:46px; border-radius:999px;
      font-size:22px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:.2s; }
    .cz-nav:hover { background:rgba(255,255,255,.25); }
    .cz-nav.prev { left:-4px; } .cz-nav.next { right:-4px; }
    .cz-nav[disabled] { opacity:.25; cursor:default; }
    @media(max-width:680px){ .cz-nav.prev{left:2px;} .cz-nav.next{right:2px;} }
    .cz-dots { display:flex; gap:7px; margin-top:14px; }
    .cz-dots i { width:7px; height:7px; border-radius:999px; background:rgba(255,255,255,.3); display:block; cursor:pointer; }
    .cz-dots i.on { background:#fff; }
    .cz-x { position:absolute; top:18px; right:22px; background:none; border:none; color:#fff; font-size:30px; cursor:pointer; line-height:1; }
    .cz-title { position:absolute; top:18px; left:24px; color:#cdd8d0; font-size:13px; max-width:60vw; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>게재 논문 — Figure 캐러셀 프로토타입</h1>
    <p class="sub">결정하신 방식입니다: 표지(또는 figure)를 <b>클릭하면 크게 열리고</b>, 좌우로 넘기며 figure들과 캡션을 봅니다.</p>
    <div class="warn">⚠️ 비공개 작업 페이지 (검색 미노출 · 라이브 미반영). 샘플 figure는 임시 논문 표지(세로형)이며, 실제로는 각 논문의 핵심 그림(가로형)으로 교체됩니다.</div>

    <h2>최종 방식</h2>
    <p class="lead">카드 표지를 클릭 → <b>큰 이미지 + 캡션</b> 모달이 열리고 <b>← → 화살표 / 스와이프 / 키보드</b>로 figure를 넘깁니다. 논문 링크는 <b>Web·PDF 버튼</b>에 그대로 유지(표지 클릭의 DOI 이동만 캐러셀로 대체).</p>

    <div class="grid">
      {papers.map((p) => (
        <div class="card">
          <div class="thumb js-open" data-figs={JSON.stringify(p.figs)} data-title={p.title} role="button" tabindex="0" aria-label={`${p.title} figures 보기`}>
            <img src={p.figs[0].src} alt={p.title} loading="lazy" />
            <span class="fig-badge">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.6-3.6a2 2 0 0 0-2.8 0L6 21"/></svg>
              {p.figs.length} figures
            </span>
            <span class="magnify">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
            </span>
          </div>
          <div class="body">
            <h4>{p.title}</h4>
            <p class="meta">{p.meta}</p>
            <div class="row">
              <a class="btn-mini" href="#" onclick="return false">PDF</a>
              <a class="btn-mini" href="#" onclick="return false">Web ↗</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Carousel lightbox -->
  <div id="cz" aria-modal="true" role="dialog">
    <button class="cz-x" aria-label="닫기">&times;</button>
    <span class="cz-title" id="cz-title"></span>
    <div class="cz-stage">
      <div class="cz-imgwrap">
        <button class="cz-nav prev" aria-label="이전">&#8249;</button>
        <img id="cz-img" src="" alt="" />
        <button class="cz-nav next" aria-label="다음">&#8250;</button>
      </div>
      <p class="cz-cap" id="cz-cap"></p>
      <p class="cz-count" id="cz-count"></p>
      <div class="cz-dots" id="cz-dots"></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const cz = document.getElementById('cz');
      const img = document.getElementById('cz-img');
      const cap = document.getElementById('cz-cap');
      const count = document.getElementById('cz-count');
      const dots = document.getElementById('cz-dots');
      const titleEl = document.getElementById('cz-title');
      const prevB = cz.querySelector('.cz-nav.prev');
      const nextB = cz.querySelector('.cz-nav.next');
      let figs = [], idx = 0;

      function render() {
        const f = figs[idx];
        img.src = f.src; img.alt = f.cap || '';
        cap.textContent = f.cap || '';
        count.textContent = (idx + 1) + ' / ' + figs.length;
        prevB.disabled = idx === 0;
        nextB.disabled = idx === figs.length - 1;
        dots.innerHTML = '';
        figs.forEach((_, i) => {
          const d = document.createElement('i');
          if (i === idx) d.className = 'on';
          d.addEventListener('click', () => { idx = i; render(); });
          dots.appendChild(d);
        });
      }
      function open(data, title) {
        figs = data; idx = 0; titleEl.textContent = title || '';
        cz.classList.add('on'); render();
      }
      function close() { cz.classList.remove('on'); img.src = ''; }
      function go(n) { idx = Math.min(figs.length - 1, Math.max(0, idx + n)); render(); }

      document.querySelectorAll('.js-open').forEach((el) => {
        const data = JSON.parse(el.getAttribute('data-figs'));
        const title = el.getAttribute('data-title');
        el.addEventListener('click', () => open(data, title));
        el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(data, title); } });
      });
      prevB.addEventListener('click', () => go(-1));
      nextB.addEventListener('click', () => go(1));
      cz.querySelector('.cz-x').addEventListener('click', close);
      cz.addEventListener('click', (e) => { if (e.target === cz) close(); });
      document.addEventListener('keydown', (e) => {
        if (!cz.classList.contains('on')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') go(-1);
        else if (e.key === 'ArrowRight') go(1);
      });
      // 터치 스와이프
      let x0 = null;
      img.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
      img.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
        x0 = null;
      }, { passive: true });
    })();
  </script>
</body>
</html>
