---
// ───────────────────────────────────────────────────────────────────────────
// PRIVATE PREVIEW — 실제 웹페이지(Publications)에 보이게 될 결과와 동일하게 렌더.
//   • 진짜 CardPaper 컴포넌트 + 실제 global.css + 실제 데이터 사용
//   • figures가 붙은 논문만 우상단 'N Figs' 배지 + 표지 클릭 → 캐러셀
//   • 라이브 페이지에 영향 없음 (nav·sitemap·robots 미포함, noindex, 어디에도 링크 안 됨)
//   • site.json엔 아직 figures 미반영 → 라이브 Publications는 그대로. 여기서만 데이터 주입.
// ───────────────────────────────────────────────────────────────────────────
import "../styles/global.css";
import CardPaper from "../components/CardPaper.astro";
import FigureCarousel from "../components/FigureCarousel.astro";
import { publications } from "../data";

const FIG = "/papers/figures/";
const figData = {
  // id 7 — Ecological Indicators (Multi-scale typologies)
  7: [
    { src: FIG + "2026_EcolIndic_Multi-scale-typologies/fig1.webp", caption: "Location of the study site and expert investigation routes. (a) Map of the Republic of Korea highlighting Gyeonggi-do and the study site; (b) Topographical map with 5 and 25 meters contour lines; (c) Distribution of main eight tree species and others; (c-1) Northern investigation route. The enlarged black box shows the layout of 5- and 10-meters radii circular analytical units; (c-2) Southern investigation route" },
    { src: FIG + "2026_EcolIndic_Multi-scale-typologies/fig2.webp", caption: "ALS point cloud based canopy cross-sections showing ten vertical layer indices variation, arranged from low to high values. (a) MIN; (b) MAX; (c) CLR; (d) TR; (e) AG; (f) LDI; (g) RV; (h) LRVI; (i) HVI; (j) VLD" },
    { src: FIG + "2026_EcolIndic_Multi-scale-typologies/fig3.webp", caption: "Error comparison of ALS-based vertical layer segmentation parameter combinations. (a) Mean Absolute Error (MAE) and Mean Squared Error (MSE) for the ten best-performing parameter sets in 5-m radius analytical units. (b) Summary of the corresponding parameter combinations (voxelization, ground point filtering height, and histogram bin size–Gaussian kernel). (c) MAE and MSE for the same parameter sets in 10-m radius analytical units." },
    { src: FIG + "2026_EcolIndic_Multi-scale-typologies/fig4.webp", caption: "PCA–HDBSCAN clustering results for 5-m radius analytical units. (a) PCA visualization of ten indices with explained variance on PC1 and PC2. Five clusters (A–E) and noise points (gray) are shown, with loading vectors displayed as a heatmap; (b) Point cloud examples for clusters A–E (b1–b5) with cross-sectional views with 3 m width (S1, S2)" },
    { src: FIG + "2026_EcolIndic_Multi-scale-typologies/fig5.webp", caption: "PCA–HDBSCAN clustering results for 10-m radius analytical units. (a) PCA visualization of ten indices with explained variance on PC1 and PC2. Four clusters (A–D) and noise points (gray) are shown, with loading vectors displayed as a heatmap; (b) Point cloud examples for clusters A–D (b1–b4) with cross-sectional views with 3 m width (S1, S2)" },
    { src: FIG + "2026_EcolIndic_Multi-scale-typologies/figS1.webp", caption: "Results for 5-m radius units. (a) the number of layers; (b) MIN; (c) MAX; (d) CLR; (e) TR; (f) AG; (g) LDI; (h) RV; (i) LRVI; (j) HVI; (k) VLD; (l) PCA-HDBSCAN clusters" },
    { src: FIG + "2026_EcolIndic_Multi-scale-typologies/figS2.webp", caption: "Results for 10-m radius units. (a) the number of layers; (b) MIN; (c) MAX; (d) CLR; (e) TR; (f) AG; (g) LDI; (h) RV; (i) LRVI; (j) HVI; (k) VLD; (l) PCA-HDBSCAN clusters" },
  ],
  // id 1 — Remote Sensing (Real-time UAV wildlife detection)
  1: [
    { src: FIG + "2021_RemoteSens_Feasibility/ga.webp",   caption: "" },
    { src: FIG + "2021_RemoteSens_Feasibility/fig1.webp", caption: "Overview of the study site." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig2.webp", caption: "Target shape categories: (a) isolated, (b) bordering, (c) overlapping, and (d) partial." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig3.webp", caption: "Representative outputs from the thermal sensor. The small image at the bottom-left is the thermal image (640 × 512 px), and the larger image is the RGB image (4000 × 3000 px). The coverage area of the thermal image is marked by the white rectangle in the RGB image." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig4.webp", caption: "Example of focal length distortion and correction. (a) Original RGB image (distorted), (b) corrected RGB image, (c) clipped RGB image, and (d) original thermal image." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig5.webp", caption: "Example of thermal image correction (fur color). (a) Original RGB image, (b) original thermal image, and (c) corrected thermal image." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig6.webp", caption: "Example of thermal image correction (unnatural). (a) Original RGB image, (b) original thermal image, and (c) corrected thermal image." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig7.webp", caption: "Example of Sobel edge detection and contour drawing. (a) Sobel x-axis outcome, (b) Sobel y-axis outcome, (c) Sobel biaxial outcome, (d) thresholded image, and (e) contoured image." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig8.webp", caption: "Regression analysis of maximum temperature and shooting height." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig9.webp", caption: "Flowchart of the detection method for all image types." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig10.webp", caption: "Calculation of detection precision and recall rate." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig11.webp", caption: "Detection results by height and type of input image." },
    { src: FIG + "2021_RemoteSens_Feasibility/fig12.webp", caption: "Thermal images taken at shooting heights of (a) 25 m, (b) 100 m, (c) 200 m, and (d) 275 m, and their pixel resolution." },
  ],
  // id 8 — KOSERT (GEDI–ALS canopy height agreement)
  8: [
    { src: FIG + "2026_KOSERT_Forest-Type-Seasonal/fig1.webp", caption: "The location of study site and distribution of GEDI footprints. (a) The location of study site (Gwacheon and Uiwang); (b) The distribution of GEDI footprints by month and the forest type distribution; (c) GEDI footprints distribution at the western part of Gwacheon; (d) GEDI footprints distribution at the western part of Uiwang" },
    { src: FIG + "2026_KOSERT_Forest-Type-Seasonal/fig2.webp", caption: "Relationship between GEDI (x-axis) and ALS (y-axis) canopy relative height 95 across forest types and periods. The hexagons represent scatter density, and marginal histograms show data distributions. Red line indicates the ordinary least squares regression fit, and the dashed vertical/horizontal lines mark the mean values of GEDI and ALS respectively. The gray dotted line indicates the y=x line. (a–c) deciduous forest; (d–f) evergreen forest; and (g–i) mixed forest. The left, middle, and right columns respectively represent combined, leaf-on, and leaf-off period results. (j) R² and RMSE of subfigures (a)–(i)." },
    { src: FIG + "2026_KOSERT_Forest-Type-Seasonal/fig3.webp", caption: "Comparison of FHD and PAI by species and periods (leaf-on and –off). Species are Larix kaempferi (LK), Robinia pseudoacacia (RP), other deciduous species (DE), Quercus acutissima (QA), Quercus variabilis (QV), other Quercus species (QU), Pinus koraiensis (PK), Pinus rigida (PR), Pinus densiflora (PD), and mixed species (MX). (a, d), (b, e) and (c, f) respectively represent FHD and PAI of deciduous, evergreen, and mixed forests." },
  ],
  // id 9 — KOSERT (LST estimation)
  9: [
    { src: FIG + "2026_KOSERT_Comparing-LST/fig1.webp", caption: "Study site. (a) The location of Chuncheon, South Korea; (b) The location of the study site within Chuncheon; (c) The northern and southern parts of the study site are high-rise and low-rise residential areas. The yellow line and colorized points indicate the UAV flight path and shoot-point locations." },
    { src: FIG + "2026_KOSERT_Comparing-LST/fig2.webp", caption: "Boxplots of land surface temperature by data source at (a) low-rise residential area; (b) high-rise residential area." },
    { src: FIG + "2026_KOSERT_Comparing-LST/fig3.webp", caption: "Spatial distribution of land surface temperature from (a) Landsat 9 satellite imagery; (b) ENVI-met simulation; (c) thermal UAV." },
    { src: FIG + "2026_KOSERT_Comparing-LST/figS1.webp", caption: "Land surface temperature at original resolution." },
  ],
};

// 실제 publication 객체에 figures 주입 (SCI→KCI, 최신순 비슷하게 4편)
const ids = [7, 1, 8, 9];
const cards = ids
  .map((id) => {
    const p = publications.find((x) => x.id === id);
    return p ? { ...p, figures: figData[id] } : null;
  })
  .filter(Boolean);
---

<!DOCTYPE html>
<html lang="ko" data-theme="shlee-light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>[비공개] Figure 미리보기 — Seunghyeon Lee</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
  <style>
    body { margin: 0; }
    .lab-wrap { max-width: 1080px; margin: 0 auto; padding: 40px 20px 120px; }
    .lab-warn { background:#fff7e6; border:1px solid #f0d68a; color:#6b5300; font-size:13px;
      padding:10px 14px; border-radius:10px; margin: 0 0 28px; }
  </style>
</head>
<body class="bg-base-100 text-base-content">
  <div class="lab-wrap">
    <div class="lab-warn">⚠️ 비공개 미리보기 — 실제 Publications에 보이게 될 결과와 동일하게 렌더됩니다. (라이브 미반영 · 검색 미노출) · figures가 있는 4편만 표시</div>

    <p class="type-eyebrow text-primary mb-3">PREVIEW — PUBLICATIONS</p>
    <h2 class="type-display-lg mb-8">게재 논문 (figure 미리보기)</h2>

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4">
      {cards.map((p) => <CardPaper paper={p} />)}
    </div>
  </div>

  <FigureCarousel />
</body>
</html>
