---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";

const {
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead ogType={ogType} />
  </head>
  <body>
    <!-- Animated topographic contour background (Canvas + simplex noise) -->
    <canvas id="topo-canvas" aria-hidden="true"></canvas>

    <div class="drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content">
        <Header />
        <div class="md:flex md:justify-center">
          <main class="p-5 sm:p-6 pt-10 lg:max-w-[900px] w-full max-w-full">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>

    <!-- Cursor spotlight tracker (desktop only, fine pointer) -->
    <script>
      if (window.matchMedia('(min-width: 1024px) and (pointer: fine)').matches) {
        document.addEventListener('mousemove', (e) => {
          document.body.style.setProperty('--cursor-x', e.clientX + 'px');
          document.body.style.setProperty('--cursor-y', e.clientY + 'px');
        });
      }
    </script>

    <!-- Forest LiDAR Point Cloud background — vertical layer slices (canopy / upper / mid / under)
         Inspired by GEDI & airborne LiDAR vertical structure visualizations.
         Points drift left→right (slow), parallax-shift with mouse, accelerate on scroll. -->
    <script>
      const canvas = document.getElementById('topo-canvas') as HTMLCanvasElement | null;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          const isTouch =
            window.matchMedia('(hover: none)').matches ||
            window.matchMedia('(pointer: coarse)').matches ||
            window.innerWidth < 1024;

          const opacityMult  = isTouch ? 0.75 : 1;
          const sizeMult     = isTouch ? 0.7  : 1;
          const targetFPS    = isTouch ? 24   : 60;
          const frameInterval = 1000 / targetFPS;
          let lastFrameTime = 0;

          let W = 0, H = 0, dpr = 1;
          function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            W = Math.floor(window.innerWidth * dpr);
            H = Math.floor(window.innerHeight * dpr);
            canvas!.width = W;
            canvas!.height = H;
            canvas!.style.width = window.innerWidth + 'px';
            canvas!.style.height = window.innerHeight + 'px';
          }
          window.addEventListener('resize', resize);
          resize();

          // ───── Layer definitions (top → bottom = canopy → forest floor) ─────
          // Colors picked per theme inside themeColors(); shapes/density here.
          type Pt = { x: number; y: number; depth: number; phase: number; size: number };
          type Layer = {
            id: string;
            yCenter: number;       // 0..1 (vertical position)
            ySpread: number;       // half-height in normalized units
            density: number;       // approx points per layer
            parallaxX: number;     // mouse parallax horizontal speed
            parallaxY: number;     // mouse parallax vertical speed (smaller)
            driftBase: number;     // idle horizontal drift (norm units / ms)
            points: Pt[];
          };

          const densityScale = isTouch ? 0.55 : 1;
          const layers: Layer[] = [
            // canopy (uppermost, sparse, large bright points — Honey Gold accent)
            { id: 'canopy', yCenter: 0.16, ySpread: 0.09, density: Math.round(280 * densityScale), parallaxX: 0.045, parallaxY: 0.020, driftBase: 0.00012, points: [] },
            // upper (mint)
            { id: 'upper',  yCenter: 0.36, ySpread: 0.08, density: Math.round(340 * densityScale), parallaxX: 0.030, parallaxY: 0.014, driftBase: 0.00010, points: [] },
            // mid (sage / secondary)
            { id: 'mid',    yCenter: 0.55, ySpread: 0.08, density: Math.round(300 * densityScale), parallaxX: 0.020, parallaxY: 0.009, driftBase: 0.00008, points: [] },
            // under (carbon — deepest, denser to suggest understory)
            { id: 'under',  yCenter: 0.76, ySpread: 0.10, density: Math.round(260 * densityScale), parallaxX: 0.012, parallaxY: 0.006, driftBase: 0.00006, points: [] },
          ];

          // Seed points within each layer's vertical band
          for (const L of layers) {
            for (let i = 0; i < L.density; i++) {
              L.points.push({
                x: Math.random(),
                y: L.yCenter + (Math.random() - 0.5) * L.ySpread * 2,
                depth: Math.random(),                       // 0=front 1=back
                phase: Math.random() * Math.PI * 2,         // pulse phase offset
                size:  0.7 + Math.random() * 1.4,           // base point radius (in dpr units)
              });
            }
          }

          // ───── Mouse + scroll state ─────
          let targetMx = 0.5, targetMy = 0.5, mx = 0.5, my = 0.5;
          let lastScrollY = window.scrollY;
          let scrollBoost = 0; // decays each frame

          window.addEventListener('mousemove', (e) => {
            targetMx = e.clientX / window.innerWidth;
            targetMy = e.clientY / window.innerHeight;
          }, { passive: true });

          window.addEventListener('scroll', () => {
            const cur = window.scrollY;
            scrollBoost = Math.min(scrollBoost + Math.abs(cur - lastScrollY) * 0.0008, 6);
            lastScrollY = cur;
          }, { passive: true });

          // ───── Theme-aware colors per layer ─────
          function themeColors() {
            const dark = document.documentElement.getAttribute('data-theme') === 'shlee-dark';
            return {
              canopy: dark ? '224, 185, 65'  : '184, 144, 32',  // Honey Gold (signature)
              upper:  dark ? '111, 191, 148' : '61, 104, 85',   // Mint / Secondary
              mid:    dark ? '160, 200, 180' : '45, 80, 60',    // Sage
              under:  dark ? '200, 215, 200' : '30, 50, 40',    // Carbon faded
            };
          }

          function colorFor(layerId: string, alpha: number) {
            const c = themeColors() as any;
            return `rgba(${c[layerId]}, ${alpha})`;
          }

          // Layer-level alpha multiplier (canopy a bit punchier)
          const layerAlphaMul: Record<string, number> = {
            canopy: 0.85,
            upper:  0.70,
            mid:    0.55,
            under:  0.45,
          };

          // ───── Pulse rings (LiDAR scan emit) ─────
          // Occasional concentric ring from a random near-center point, very subtle.
          type Pulse = { x: number; y: number; t: number; max: number };
          const pulses: Pulse[] = [];
          let nextPulseIn = 2200; // ms until next pulse

          // ───── Main draw loop ─────
          function frame(now: number) {
            if (now - lastFrameTime < frameInterval) {
              requestAnimationFrame(frame);
              return;
            }
            const dt = Math.min((now - lastFrameTime) || 16, 60);
            lastFrameTime = now;

            // Eased mouse follow
            mx += (targetMx - mx) * 0.08;
            my += (targetMy - my) * 0.08;

            // Scroll boost decay
            scrollBoost *= 0.94;
            const driftMul = 1 + scrollBoost;

            ctx!.clearRect(0, 0, W, H);

            // ─── Draw layers back→front so depth feels right ───
            for (const L of layers) {
              const baseAlphaMul = (layerAlphaMul[L.id] ?? 0.6) * opacityMult;

              // Mouse parallax offset for this layer
              const parX = (mx - 0.5) * L.parallaxX;
              const parY = (my - 0.5) * L.parallaxY;

              for (const p of L.points) {
                // Idle horizontal drift + scroll boost
                p.x += L.driftBase * dt * driftMul;
                if (p.x > 1.15) p.x -= 1.3;

                // Slow pulse phase (subtle brightness oscillation per point)
                p.phase += 0.0004 * dt;
                const pulse = 0.7 + 0.3 * Math.sin(p.phase);

                const screenX = (p.x + parX) * W;
                const screenY = (p.y + parY) * H;

                // Skip if off-screen (with margin for parallax)
                if (screenX < -20 || screenX > W + 20) continue;

                // Depth-based size + alpha
                const depthFactor = 1 - p.depth * 0.55;
                const r = p.size * depthFactor * sizeMult * dpr * (0.85 + 0.15 * pulse);
                const a = baseAlphaMul * (1 - p.depth * 0.45) * (0.65 + 0.35 * pulse);

                ctx!.fillStyle = colorFor(L.id, a);
                ctx!.beginPath();
                ctx!.arc(screenX, screenY, r, 0, Math.PI * 2);
                ctx!.fill();
              }
            }

            // ─── LiDAR pulse rings (emit) ───
            nextPulseIn -= dt;
            if (nextPulseIn <= 0 && !isTouch) {
              // Spawn from a random point biased toward viewport center-ish
              pulses.push({
                x: 0.35 + Math.random() * 0.30,
                y: 0.30 + Math.random() * 0.45,
                t: 0,
                max: 700 + Math.random() * 600, // duration in ms
              });
              nextPulseIn = 3200 + Math.random() * 2400;
            }
            for (let i = pulses.length - 1; i >= 0; i--) {
              const pl = pulses[i];
              pl.t += dt;
              if (pl.t >= pl.max) { pulses.splice(i, 1); continue; }

              const progress = pl.t / pl.max;
              const radius = progress * Math.min(W, H) * 0.18 * dpr;
              const alpha = 0.20 * (1 - progress) * (1 - progress) * opacityMult;

              ctx!.strokeStyle = colorFor('canopy', alpha);
              ctx!.lineWidth = 1.0 * dpr;
              ctx!.beginPath();
              ctx!.arc(pl.x * W, pl.y * H, radius, 0, Math.PI * 2);
              ctx!.stroke();
            }

            requestAnimationFrame(frame);
          }
          requestAnimationFrame(frame);
        }
      }
    </script>
  </body>
</html>
