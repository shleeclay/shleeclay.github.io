---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";

const {
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead ogType={ogType} />
  </head>
  <body>
    <!-- Animated topographic contour background (Canvas + simplex noise) -->
    <canvas id="topo-canvas" aria-hidden="true"></canvas>

    <div class="drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content">
        <Header />
        <div class="md:flex md:justify-center">
          <main class="p-5 sm:p-6 pt-10 lg:max-w-[900px] w-full max-w-full">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>

    <!-- Cursor spotlight tracker (desktop only, fine pointer) -->
    <script>
      if (window.matchMedia('(min-width: 1024px) and (pointer: fine)').matches) {
        document.addEventListener('mousemove', (e) => {
          document.body.style.setProperty('--cursor-x', e.clientX + 'px');
          document.body.style.setProperty('--cursor-y', e.clientY + 'px');
        });
      }
    </script>

    <!-- Forest LiDAR scan background — airborne LiDAR sweep visualization.
         A scan band sweeps top→bottom; points only fully illuminate when the
         scan reaches them, then fade over ~1.2s (return-pulse decay).
         Each point has its own "reflectivity" so only a subset lights up. -->
    <script>
      const canvas = document.getElementById('topo-canvas') as HTMLCanvasElement | null;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          const isTouch =
            window.matchMedia('(hover: none)').matches ||
            window.matchMedia('(pointer: coarse)').matches ||
            window.innerWidth < 1024;

          const opacityMult   = isTouch ? 0.85 : 1;
          const sizeMult      = isTouch ? 0.75 : 1;
          const targetFPS     = isTouch ? 24   : 60;
          const frameInterval = 1000 / targetFPS;
          let lastFrameTime = 0;

          let W = 0, H = 0, dpr = 1;
          function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            W = Math.floor(window.innerWidth * dpr);
            H = Math.floor(window.innerHeight * dpr);
            canvas!.width = W;
            canvas!.height = H;
            canvas!.style.width = window.innerWidth + 'px';
            canvas!.style.height = window.innerHeight + 'px';
          }
          window.addEventListener('resize', resize);
          resize();

          // ───── Layers (top → bottom: canopy → understory) ─────
          type Pt = {
            x: number; y: number;
            depth: number;
            size: number;
            reflectivity: number;    // 0..1, scan only activates if random < reflectivity
            lastActivatedAt: number; // ms timestamp of most recent activation
          };
          type Layer = {
            id: string;
            yCenter: number;
            ySpread: number;
            density: number;
            parallaxX: number;
            parallaxY: number;
            driftBase: number;
            points: Pt[];
          };

          const densityScale = isTouch ? 0.55 : 1;
          const layers: Layer[] = [
            { id: 'canopy', yCenter: 0.16, ySpread: 0.10, density: Math.round(320 * densityScale), parallaxX: 0.045, parallaxY: 0.020, driftBase: 0.00010, points: [] },
            { id: 'upper',  yCenter: 0.37, ySpread: 0.09, density: Math.round(380 * densityScale), parallaxX: 0.030, parallaxY: 0.014, driftBase: 0.00008, points: [] },
            { id: 'mid',    yCenter: 0.56, ySpread: 0.09, density: Math.round(340 * densityScale), parallaxX: 0.020, parallaxY: 0.009, driftBase: 0.00006, points: [] },
            { id: 'under',  yCenter: 0.78, ySpread: 0.10, density: Math.round(280 * densityScale), parallaxX: 0.012, parallaxY: 0.006, driftBase: 0.00005, points: [] },
          ];

          for (const L of layers) {
            for (let i = 0; i < L.density; i++) {
              L.points.push({
                x: Math.random(),
                y: L.yCenter + (Math.random() - 0.5) * L.ySpread * 2,
                depth: Math.random(),
                size: 1.4 + Math.random() * 2.0,    // bigger than before
                reflectivity: 0.35 + Math.random() * 0.55,  // 35%-90% chance to fire on scan
                lastActivatedAt: -10000,
              });
            }
          }

          // ───── Mouse + scroll state ─────
          let targetMx = 0.5, targetMy = 0.5, mx = 0.5, my = 0.5;
          let lastScrollY = window.scrollY;
          let scrollBoost = 0;

          window.addEventListener('mousemove', (e) => {
            targetMx = e.clientX / window.innerWidth;
            targetMy = e.clientY / window.innerHeight;
          }, { passive: true });

          window.addEventListener('scroll', () => {
            const cur = window.scrollY;
            scrollBoost = Math.min(scrollBoost + Math.abs(cur - lastScrollY) * 0.0008, 4);
            lastScrollY = cur;
          }, { passive: true });

          // ───── Scan state ─────
          // Scan band moves top→bottom continuously. When point's y is within
          // SCAN_BAND of scanY, it has a chance to "fire" (proportional to its
          // reflectivity). Activated points illuminate intensely then fade.
          const SCAN_CYCLE_MS = 6500;      // one full sweep top→bottom
          const SCAN_BAND     = 0.025;     // half-width of active band (norm units)
          const FADE_MS       = 1200;      // how long a point stays lit after fire
          let scanStart = performance.now();

          // ───── Theme-aware colors per layer ─────
          function themeColors() {
            const dark = document.documentElement.getAttribute('data-theme') === 'shlee-dark';
            return {
              // Active (illuminated by scan) colors — punchy
              activeCanopy: dark ? '255, 220, 110' : '224, 185, 65',   // bright honey
              activeUpper:  dark ? '160, 230, 190' : '111, 191, 148',  // bright mint
              activeMid:    dark ? '190, 220, 200' : '74, 138, 110',
              activeUnder:  dark ? '210, 225, 210' : '50, 90, 70',
              // Dim base colors — barely visible until scan hits
              dimCanopy:    dark ? '224, 185, 65'  : '184, 144, 32',
              dimUpper:     dark ? '111, 191, 148' : '61, 104, 85',
              dimMid:       dark ? '160, 200, 180' : '45, 80, 60',
              dimUnder:     dark ? '200, 215, 200' : '30, 50, 40',
            };
          }
          function rgb(c: any, key: string, alpha: number) {
            return `rgba(${c[key]}, ${alpha})`;
          }

          // Base layer alpha (dim, pre-activation)
          const dimAlphaMul: Record<string, number> = {
            canopy: 0.32, upper: 0.26, mid: 0.20, under: 0.16,
          };
          // Activation alpha boost (when scan hits)
          const activeAlphaMul: Record<string, number> = {
            canopy: 0.95, upper: 0.85, mid: 0.70, under: 0.55,
          };

          // ───── Main draw loop ─────
          function frame(now: number) {
            if (now - lastFrameTime < frameInterval) {
              requestAnimationFrame(frame);
              return;
            }
            const dt = Math.min((now - lastFrameTime) || 16, 60);
            lastFrameTime = now;

            // Eased mouse follow
            mx += (targetMx - mx) * 0.08;
            my += (targetMy - my) * 0.08;

            // Scroll boost decay
            scrollBoost *= 0.94;
            const driftMul = 1 + scrollBoost;

            // Scan progress (0..1, top→bottom). Resets seamlessly.
            const elapsed = (now - scanStart) % SCAN_CYCLE_MS;
            const scanY = elapsed / SCAN_CYCLE_MS;

            ctx!.clearRect(0, 0, W, H);
            const cols = themeColors();

            // Optional: render the scan band itself as a very faint horizontal sweep
            // (very subtle so points are the main signal, but band gives motion cue).
            const bandTopY    = (scanY - SCAN_BAND * 0.5) * H;
            const bandHeight  = SCAN_BAND * 1.0 * H;
            const bandGrad = ctx!.createLinearGradient(0, bandTopY, 0, bandTopY + bandHeight);
            bandGrad.addColorStop(0,   rgb(cols, 'activeCanopy', 0));
            bandGrad.addColorStop(0.5, rgb(cols, 'activeCanopy', 0.10 * opacityMult));
            bandGrad.addColorStop(1,   rgb(cols, 'activeCanopy', 0));
            ctx!.fillStyle = bandGrad;
            ctx!.fillRect(0, bandTopY, W, bandHeight);

            // ─── Draw layers ───
            for (const L of layers) {
              const dimMul    = dimAlphaMul[L.id]    ?? 0.20;
              const activeMul = activeAlphaMul[L.id] ?? 0.80;
              const dimKey    = ('dim'    + L.id.charAt(0).toUpperCase() + L.id.slice(1));
              const activeKey = ('active' + L.id.charAt(0).toUpperCase() + L.id.slice(1));

              const parX = (mx - 0.5) * L.parallaxX;
              const parY = (my - 0.5) * L.parallaxY;

              for (const p of L.points) {
                // Idle horizontal drift
                p.x += L.driftBase * dt * driftMul;
                if (p.x > 1.15) p.x -= 1.3;

                // Scan hit detection — has scan band passed near this point recently?
                const dy = Math.abs(p.y - scanY);
                if (dy < SCAN_BAND) {
                  // Within band → roll dice against reflectivity each frame
                  // (rate-limited by reflectivity & dt)
                  if (Math.random() < p.reflectivity * dt * 0.012) {
                    p.lastActivatedAt = now;
                  }
                }

                // Compute activation strength (1.0 right at hit → 0 after FADE_MS)
                const sinceActive = now - p.lastActivatedAt;
                let act = 0;
                if (sinceActive >= 0 && sinceActive < FADE_MS) {
                  const t = sinceActive / FADE_MS;
                  // Sharp rise, slow decay (square-root style)
                  act = Math.max(0, 1 - Math.sqrt(t));
                }

                const screenX = (p.x + parX) * W;
                const screenY = (p.y + parY) * H;
                if (screenX < -20 || screenX > W + 20) continue;

                const depthFactor = 1 - p.depth * 0.50;

                // Dim base — always visible (subtle)
                const dimA = dimMul * (1 - p.depth * 0.45) * opacityMult;
                const dimR = p.size * depthFactor * sizeMult * dpr * 0.6;
                ctx!.fillStyle = rgb(cols, dimKey, dimA);
                ctx!.beginPath();
                ctx!.arc(screenX, screenY, dimR, 0, Math.PI * 2);
                ctx!.fill();

                // Active overlay — only when activated, with glow
                if (act > 0.01) {
                  const actA = activeMul * act * opacityMult;
                  const actR = p.size * depthFactor * sizeMult * dpr * (1.0 + act * 1.6);

                  // Outer glow (slightly larger, low alpha)
                  ctx!.fillStyle = rgb(cols, activeKey, actA * 0.35);
                  ctx!.beginPath();
                  ctx!.arc(screenX, screenY, actR * 1.9, 0, Math.PI * 2);
                  ctx!.fill();

                  // Core (bright)
                  ctx!.fillStyle = rgb(cols, activeKey, actA);
                  ctx!.beginPath();
                  ctx!.arc(screenX, screenY, actR, 0, Math.PI * 2);
                  ctx!.fill();
                }
              }
            }

            requestAnimationFrame(frame);
          }
          requestAnimationFrame(frame);
        }
      }
    </script>
  </body>
</html>
