---
import site from "../data/site.json";
const c = site.contact;
const { lang = "ko" } = Astro.props;
const otherLangHref  = lang === "ko" ? "/en" : "/";
const otherLangLabel = lang === "ko" ? "EN" : "KO";
---

<div class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"></div>

<div class="social-icons px-3 pb-5 pt-1 flex flex-wrap items-center self-center justify-center sticky bottom-0 bg-base-200 gap-1">
  <!-- Email -->
  <a href={`mailto:${c.email}`} class="icon-btn" aria-label="Email" title={c.email}>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22,6 12,13 2,6"></polyline>
    </svg>
  </a>

  <!-- Google Scholar -->
  {c.scholarUrl && (
    <a href={c.scholarUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Google Scholar" title="Google Scholar">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14l-9-5.4L12 3l9 5.6L12 14zm0 1.1l-7-4.2v3.3c0 2.8 3.1 5.1 7 5.1s7-2.3 7-5.1v-3.3l-7 4.2z"/></svg>
    </a>
  )}

  <!-- ORCID -->
  {c.orcidUrl && (
    <a href={c.orcidUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="ORCID" title="ORCID">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor"><path d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0zM86.4 186.2H70.5V79.1h15.9v107.1zm-7.9-122.3a9.2 9.2 0 1 1 0-18.4 9.2 9.2 0 0 1 0 18.4zm116.6 122.3h-15.7v-52c0-12.4-.2-28.4-17.3-28.4-17.3 0-20 13.5-20 27.5v52.9h-15.7V79.1h15v14.6h.2c2.1-4 7.2-8.2 14.8-8.2 15.8 0 18.7 10.4 18.7 24v76.7z"/></svg>
    </a>
  )}

  <!-- ResearchGate -->
  {c.researchGateUrl && (
    <a href={c.researchGateUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="ResearchGate" title="ResearchGate">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.586 0c-.818 0-1.508.19-2.073.565-.563.377-.97.936-1.213 1.68a3.193 3.193 0 0 0-.112.437 8.365 8.365 0 0 0-.078.53 9 9 0 0 0-.05.727L16.04 4.5l.02 1.052.05.725a8.5 8.5 0 0 0 .078.531c.029.165.066.31.112.438.243.742.65 1.302 1.213 1.678.565.376 1.255.566 2.073.566.857 0 1.638-.213 2.342-.64a4.51 4.51 0 0 0 1.66-1.736l-1.92-1.104a2.39 2.39 0 0 1-.86.92 2.27 2.27 0 0 1-1.221.317 2.42 2.42 0 0 1-.785-.12 1.61 1.61 0 0 1-.6-.36 1.717 1.717 0 0 1-.39-.575 2.797 2.797 0 0 1-.205-.79 8.3 8.3 0 0 1-.07-.99 8.3 8.3 0 0 1 .07-.99c.044-.295.115-.553.205-.79a1.7 1.7 0 0 1 .39-.575c.165-.16.365-.282.6-.36.235-.078.495-.12.785-.12.466 0 .872.107 1.221.317.349.21.636.516.86.92l1.92-1.103A4.514 4.514 0 0 0 21.928.64C21.224.214 20.444 0 19.586 0zM7.99 4.853c-2.317 0-3.96 1.5-3.96 4.135 0 2.732 1.515 4.13 3.84 4.13.79 0 1.557-.21 1.937-.553h.05v.514c0 1.5-.717 2.353-2.234 2.353-1.075 0-1.694-.42-1.85-1.107H3.205c.198 1.71 1.704 2.97 4.486 2.97 3.022 0 4.764-1.485 4.764-4.612V4.985H10.18v.685h-.05c-.38-.456-1.247-.817-2.14-.817zm.198 1.71c1.354 0 2.234.954 2.234 2.495 0 1.522-.88 2.413-2.234 2.413-1.354 0-2.234-.94-2.234-2.413 0-1.541.88-2.495 2.234-2.495z"/></svg>
    </a>
  )}

  <!-- LinkedIn -->
  {c.linkedinUrl && (
    <a href={c.linkedinUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn" title="LinkedIn">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
    </a>
  )}

  <!-- CV download (PDF) — full CV -->
  {c.cvFullUrl && (
    <a href={c.cvFullUrl} download class="icon-btn" aria-label="Download CV (PDF)" title="Download full CV (PDF)">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
    </a>
  )}

  <!-- Divider -->
  <span class="w-px h-5 bg-base-300 mx-1"></span>

  <!-- Language switch — links to the other-language route (URL-based i18n) -->
  <a href={otherLangHref} class="icon-btn lang-toggle-btn" aria-label="Switch language" title={`Switch to ${otherLangLabel}`}>
    <span class="text-[11px] font-semibold tracking-wider">{otherLangLabel}</span>
  </a>

  <!-- Theme toggle -->
  <button id="theme-toggle" class="icon-btn theme-toggle-btn" aria-label="Toggle theme" title="Toggle light / dark">
    <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
    </svg>
    <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
</div>

<script is:inline>
  (function () {
    // Theme toggle
    const tToggle = document.getElementById('theme-toggle');
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    function syncIcon() {
      const t = document.documentElement.getAttribute('data-theme');
      if (t === 'shlee-dark') { sun.classList.remove('hidden'); moon.classList.add('hidden'); }
      else                    { moon.classList.remove('hidden'); sun.classList.add('hidden'); }
    }
    if (tToggle) {
      syncIcon();
      tToggle.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        const next = cur === 'shlee-dark' ? 'shlee-light' : 'shlee-dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('shleeclay-theme', next);
        syncIcon();
      });
    }
    // Language is route-based now (/, /en) — switch handled by the <a> link, no JS needed.
  })();
</script>

<style>
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: hsl(var(--bc) / 0.7);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .icon-btn:hover {
    background-color: hsl(var(--b3));
    color: #1e3a2f;
  }
  :global(html[data-theme="shlee-dark"]) .icon-btn:hover {
    color: #6fbf94;
  }
  .lang-toggle-btn, .theme-toggle-btn {
    color: hsl(var(--bc) / 0.7);
  }
</style>
