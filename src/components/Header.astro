---
import LangToggle from "./LangToggle.astro";
const { lang = "ko" } = Astro.props;
const homeHref = lang === "en" ? "/en/" : "/";
---

<div
  class="sticky lg:hidden top-0 z-30 flex h-16 w-full justify-center bg-base-100/80 backdrop-blur transition-all duration-100 text-base-content border-b border-base-300"
>
  <div class="navbar px-3">
    <div class="navbar-start">
      <label for="my-drawer" class="btn btn-ghost p-0 w-14 h-14 min-h-14 rounded-xl flex items-center justify-center" aria-label="메뉴 열기">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-14 h-14 stroke-current">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    </div>
    <div class="navbar-center">
      <a class="btn btn-ghost normal-case text-xl gap-2" href={homeHref}>
        <span aria-hidden="true">🌿</span>
        <span data-only="ko">이승현</span><span data-only="en">Seunghyeon Lee</span>
      </a>
    </div>
    <div class="navbar-end gap-1.5">
      <LangToggle lang={lang} />
      <button
        id="theme-toggle-hdr"
        type="button"
        class="inline-flex items-center justify-center w-9 h-9 rounded-lg text-base-content/70 hover:bg-base-300/50 hover:text-primary transition-colors"
        aria-label="Toggle light / dark theme"
        title="Toggle light / dark"
      >
        <svg id="theme-icon-sun-hdr" class="hidden" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="theme-icon-moon-hdr" class="hidden" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle-hdr');
    var sun = document.getElementById('theme-icon-sun-hdr');
    var moon = document.getElementById('theme-icon-moon-hdr');
    if (!btn || !sun || !moon) return;
    function sync() {
      var dark = document.documentElement.getAttribute('data-theme') === 'shlee-dark';
      sun.classList.toggle('hidden', !dark);
      moon.classList.toggle('hidden', dark);
    }
    sync();
    btn.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme');
      var next = cur === 'shlee-dark' ? 'shlee-light' : 'shlee-dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('shleeclay-theme', next); } catch (e) {}
      sync();
    });
  })();
</script>
