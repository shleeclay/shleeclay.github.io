---
const { lang = "ko" } = Astro.props;
const homeHref = lang === "en" ? "/en" : "/";
---

<div
  class="sticky lg:hidden top-0 z-30 flex h-16 w-full justify-center bg-base-100/80 backdrop-blur transition-all duration-100 text-base-content border-b border-base-300"
>
  <div class="navbar px-3">
    <div class="navbar-start">
      <label for="my-drawer" class="btn btn-ghost p-0 w-12 h-12 min-h-12 rounded-xl flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-8 h-8 stroke-current">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    </div>
    <div class="navbar-center">
      <a class="btn btn-ghost normal-case text-xl gap-2" href={homeHref}>
        <span aria-hidden="true">🌿</span>
        <span data-only="ko">이승현</span><span data-only="en">Seunghyeon Lee</span>
      </a>
    </div>
    <div class="navbar-end"></div>
  </div>
</div>
