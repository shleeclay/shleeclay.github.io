---
import BaseLayout from "../layouts/BaseLayout.astro";
import L from "./L.astro";
import CardPaper from "./CardPaper.astro";
import CardPatent from "./CardPatent.astro";
import CardBook from "./CardBook.astro";
import site, {
  publications, underReview, conferences, projects, patents,
  teaching, career, education,
  scholarships, certifications, books,
  groupByYear, fmtRange, fmtDate,
} from "../data";

// Page language is fixed per route: "/" → ko, "/en" → en
const { lang = "ko" } = Astro.props as { lang?: "ko" | "en" };

const hero    = site.hero;
const about   = site.about;
const contact = site.contact;

// Phone — bot 보호 + hover 시에만 표시. 실제 번호는 char-code 배열로만 내려보내고
// HTML 소스엔 placeholder만 노출. JS가 mouseenter/focus/touch 시 복원.
const phoneShown       = lang === "en" ? contact.phone.en : contact.phone.ko;
const phoneChars       = [...phoneShown].map((c) => c.charCodeAt(0));
const telChars         = [...contact.phoneTelLink].map((c) => c.charCodeAt(0));
const phonePlaceholder = lang === "en" ? "Hover to reveal" : "마우스를 올리면 표시";

// Publications order: SCI (newest first) → KCI (newest first).
// SCI is detected by presence of quartile/IF (국제 저널 지표); KCI(KOSERT 등)은 없음.
const isSCI = (p: typeof publications[number]) => !!(p.quartile || p.if);
const pubDateKey = (p: typeof publications[number]) => p.date || `${p.year}/00/00`;
const sortedPublications = [...publications].sort((a, b) => {
  const sa = isSCI(a), sb = isSCI(b);
  if (sa !== sb) return sa ? -1 : 1;                 // SCI group first
  return pubDateKey(b).localeCompare(pubDateKey(a)); // newest first within group
});

// Group time-based items by year (Patents render as a grid; Conferences/Teaching stay year-grouped)
const confsByYear  = groupByYear(conferences);
const teachByYear  = groupByYear(teaching);

// Split patents: registered → card grid; application → compact list
const registeredPatents  = patents.filter((p) => p.status === 'registered');
const applicationPatents = patents.filter((p) => p.status === 'application');

// Type label maps
const teachTypeLabels: Record<string, { ko: string; en: string }> = {
  special: { ko: "특강",        en: "Special" },
  univ:    { ko: "대학 강의",   en: "University" },
  online:  { ko: "온라인 강의", en: "Online" },
};

const confTypeLabels: Record<string, string> = {
  oral:   "Oral",
  poster: "Poster",
  video:  "Video",
};
---

<BaseLayout lang={lang} sideBarActiveItemID="about">
  <!-- ───────── HERO ───────── -->
  <section id="top" class="pb-16 pt-8 scroll-mt-12 animate-fade-up">
    <div class="flex flex-col-reverse md:flex-row md:items-center gap-8">
      <div class="flex-1">
        <p class="type-eyebrow text-base-content/70 mb-4" aria-hidden="true">🌿 RESEARCH PORTFOLIO</p>

        <h1 class="type-display-xl mb-5 leading-[0.98]">
          <span data-only="ko">{hero.name.ko}</span>
          <span data-only="en">{hero.name.en}</span>
          <span class="text-primary"> </span>
          <span class="type-headline text-base-content/70 align-baseline">
            <span data-only="ko">{hero.nameSub.ko}</span>
            <span data-only="en">{hero.nameSub.en}</span>
          </span>
        </h1>

        <L tag="p" class="type-headline text-base-content/85 mb-4 max-w-2xl" ko={hero.tagline.ko} en={hero.tagline.en} />
        <L tag="p" class="type-body text-base-content/65 max-w-2xl mb-5" ko={hero.description.ko} en={hero.description.en} />

        <L
          tag="p"
          class="type-body-sm text-base-content/70 mb-7 pl-3 border-l-2"
          ko={hero.affiliation.ko}
          en={hero.affiliation.en}
        />

        <div class="flex flex-wrap gap-3">
          <a href="#publications" class="btn btn-primary gap-2">
            <span data-only="ko">{hero.ctaPrimary.ko}</span>
            <span data-only="en">{hero.ctaPrimary.en}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="#contact" class="btn btn-outline btn-primary">
            <span data-only="ko">{hero.ctaSecondary.ko}</span>
            <span data-only="en">{hero.ctaSecondary.en}</span>
          </a>
          <a href={contact.cvFullUrl} download class="btn btn-outline btn-primary gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            <span data-only="ko">CV 다운로드</span><span data-only="en">Download CV</span>
          </a>
        </div>
      </div>

      <!-- Profile image -->
      <div class="shrink-0">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl overflow-hidden ring-1 ring-base-300 shadow-lg">
          <img src="/profile.webp" alt="Seunghyeon Lee" width="450" height="450" decoding="async" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── ABOUT ───────── -->
  <section id="about" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{about.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-8" ko={about.title.ko} en={about.title.en} />

    <div class="space-y-4 mb-10 max-w-2xl">
      {about.paragraphs.ko.map((p, i) => (
        <p class="type-body-lg text-base-content/85" data-only="ko">{p}</p>
      ))}
      {about.paragraphs.en.map((p, i) => (
        <p class="type-body-lg text-base-content/85" data-only="en">{p}</p>
      ))}
    </div>

    <!-- Research interests -->
    <L tag="p" class="type-eyebrow text-base-content/65 mb-3" ko={about.interestsLabel.ko} en={about.interestsLabel.en} />
    <div class="flex flex-wrap gap-2 mb-10">
      {about.interests.ko.map((i) => (
        <span class="pill pill-co interest" data-only="ko">{i}</span>
      ))}
      {about.interests.en.map((i) => (
        <span class="pill pill-co interest" data-only="en">{i}</span>
      ))}
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {about.stats.map((stat) => (
        <div class="stat-box p-4 rounded-2xl bg-base-200/60 border border-base-300/60">
          <p class="type-caption text-base-content/70 mb-1">
            <span data-only="ko">{stat.label.ko}</span>
            <span data-only="en">{stat.label.en}</span>
          </p>
          <p class="text-primary" style="font-size:26px;font-weight:600;line-height:1;">
            {stat.value}
            <span class="text-xs font-normal text-base-content/70 ml-1">
              <span data-only="ko">{stat.unit.ko}</span>
              <span data-only="en">{stat.unit.en}</span>
            </span>
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── EDUCATION ───────── -->
  <section id="education" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.education.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-8" ko={site.education.title.ko} en={site.education.title.en} />

    <div class="space-y-4">
      {education.map((e) => (
        <div class="research-card flex gap-4 -mx-[18px]">
          <!-- Logo slot (square) -->
          <div class="shrink-0 w-[72px] h-[72px] rounded-lg bg-white border border-base-300/60 flex items-center justify-center overflow-hidden">
            {e.logo ? (
              <img src={e.logo} alt="" class="max-w-[80%] max-h-[80%] object-contain" loading="lazy" />
            ) : (
              <span class="text-base-content/30 text-2xl">🎓</span>
            )}
          </div>
          <div class="flex-1 min-w-0">
            <p class="type-caption text-base-content/70 mb-1">{e.period}</p>
            <h3 class="type-card-title mb-1">
              <span data-only="ko">{e.degree.ko}{' · '}{e.program.ko}</span>
              <span data-only="en">{e.degree.en}{' · '}{e.program.en}</span>
            </h3>
            <p class="type-body-sm text-base-content/70">
              <span data-only="ko">{e.institution.ko}</span>
              <span data-only="en">{e.institution.en}</span>
            </p>
            {e.lab && (
              <p class="type-body-sm text-base-content/70 mt-1">
                <span data-only="ko">{e.lab.ko}{e.advisor ? ` · ${e.advisor.ko}` : ''}</span>
                <span data-only="en">{e.lab.en}{e.advisor ? ` · ${e.advisor.en}` : ''}</span>
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── PUBLICATIONS — card grid (3 cols) ───────── -->
  <section id="publications" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.publications.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-3" ko={`${site.publications.title.ko} (${publications.length})`} en={`${site.publications.title.en} (${publications.length})`} />
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.publications.intro.ko} en={site.publications.intro.en} />

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4">
      {sortedPublications.map((p) => <CardPaper paper={p} />)}
    </div>

    <!-- Manuscripts under review — list (conference-style), not cards -->
    {underReview.length > 0 && (
      <div class="mt-12">
        <div class="flex items-baseline gap-3 mb-4">
          <span class="pill pill-app">
            <span data-only="ko">심사 중</span>
            <span data-only="en">Under Review</span>
          </span>
          <p class="type-caption text-base-content/70">
            <span data-only="ko">{site.publications.underReview.note.ko}</span>
            <span data-only="en">{site.publications.underReview.note.en}</span>
          </p>
        </div>
        <div class="space-y-2 pl-4 border-l-2 border-base-300/40">
          {underReview.map((m) => (
            <div class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 py-2.5 hover:bg-base-200/60 -mx-2 px-2 rounded-md transition-colors">
              <div class="flex flex-wrap items-center gap-2 md:contents">
                <span class="shrink-0 type-body-sm text-base-content/70 whitespace-nowrap w-fit md:w-20">
                  {m.date.replace("/", ".")}
                </span>
                <span class={`shrink-0 pill ${m.role === "first" ? "pill-first" : "pill-co"}`}>
                  <span data-only="ko">{m.status.ko}</span>
                  <span data-only="en">{m.status.en}</span>
                </span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="type-body text-base-content leading-snug" style="font-weight:480;">{m.title}</p>
                <p class="type-body-sm text-base-content/70 mt-0.5">
                  {m.authors.map((a, i) => (
                    <>{i > 0 ? ", " : ""}{a === "Seunghyeon Lee" ? <strong class="font-bold text-primary">{a}</strong> : a}</>
                  ))}
                  <span class="mx-1.5 text-base-content/30">·</span>
                  <span class="italic">{m.journal}</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Books (moved from Honors) -->
    <L tag="p" class="type-caption text-base-content/65 mb-4 mt-12" ko={`${site.honors.books.label.ko} (${books.length})`} en={`${site.honors.books.label.en} (${books.length})`} />
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4">
      {books.map((b) => <CardBook book={b} />)}
    </div>
  </section>

  <!-- ───────── CONFERENCES ───────── -->
  <section id="conferences" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.conferences.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-3" ko={`${site.conferences.title.ko} (${conferences.length})`} en={`${site.conferences.title.en} (${conferences.length})`} />
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.conferences.intro.ko} en={site.conferences.intro.en} />

    <div class="space-y-8 pl-4 border-l-2 border-base-300/40">
      {confsByYear.map(({ year, items }) => (
        <div class="relative">
          <div class="absolute -left-[1.45rem] top-1.5">
            <span class="block w-3 h-3 rounded-full bg-primary ring-4 ring-base-100"></span>
          </div>
          <h3 class="year-head mb-3">{year}</h3>
          <div class="space-y-2">
            {items.map((c) => (
              <div class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 py-2.5 hover:bg-base-200/60 -mx-2 px-2 rounded-md transition-colors">
                <div class="flex flex-wrap items-center gap-2 md:contents">
                  <span class="shrink-0 type-body-sm text-base-content/70 whitespace-nowrap w-fit md:w-24 md:pr-3">
                    {fmtDate(c.date)}
                  </span>
                  <span class={`shrink-0 pill ${c.scope === 'international' ? 'pill-intl' : 'pill-domestic'}`}>
                    {confTypeLabels[c.type] || c.type} · {c.scope === 'international' ? 'Intl.' : 'Domestic'}
                  </span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="type-body text-base-content leading-snug" style="font-weight:480;">
                    <span data-only="ko">{c.title.ko}</span>
                    <span data-only="en">{c.title.en}</span>
                  </p>
                  <p class="type-body-sm text-base-content/70 mt-0.5">
                    <span data-only="ko">{typeof c.conference === "string" ? c.conference : c.conference.ko}</span>
                    <span data-only="en">{typeof c.conference === "string" ? c.conference : c.conference.en}</span>
                    {' · '}
                    <span data-only="ko">{c.venue.ko}</span>
                    <span data-only="en">{c.venue.en}</span>
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── TEACHING ───────── -->
  <section id="teaching" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.teaching.eyebrow}</p>
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <L tag="h2" class="type-display-lg" ko={`${site.teaching.title.ko} (${teaching.length})`} en={`${site.teaching.title.en} (${teaching.length})`} />
      <a href={lang === "en" ? "https://upwise.co.kr/en" : "https://upwise.co.kr"} target="_blank" rel="noopener noreferrer" class="upwise-badge" aria-label="upwise.co.kr — GIS 강사" title="upwise.co.kr — GIS Instructor">
        <span class="upwise-wordmark"><span class="uw-up">UP</span><span class="uw-wise">WISE</span><span class="uw-dot">.</span></span>
        <span class="upwise-badge-text">
          <span data-only="ko">GIS 강사</span>
          <span data-only="en">GIS Instructor</span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
    <L tag="p" class="type-body text-base-content/70 mb-8" ko={site.teaching.intro.ko} en={site.teaching.intro.en} />

    <div class="space-y-8 pl-4 border-l-2 border-base-300/40">
      {teachByYear.map(({ year, items }) => (
        <div class="relative">
          <div class="absolute -left-[1.45rem] top-1.5">
            <span class="block w-3 h-3 rounded-full bg-primary ring-4 ring-base-100"></span>
          </div>
          <h3 class="year-head mb-3">{year}</h3>
          <div class="space-y-2">
            {items.map((t) => {
              const label = teachTypeLabels[t.type] || { ko: t.type, en: t.type };
              return (
                <div class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3 py-2 px-2 -mx-2 rounded-md hover:bg-base-200/60 transition-colors">
                  <div class="flex flex-wrap items-center gap-2 md:contents">
                    <span class="shrink-0 type-body-sm text-base-content/70 whitespace-nowrap w-fit md:w-36">
                      {fmtRange(t.date, t.dateEnd)}
                    </span>
                    <span class={`shrink-0 pill ${t.type === "univ" ? "pill-first" : "pill-co"}`}>
                      <span data-only="ko">{label.ko}</span>
                      <span data-only="en">{label.en}</span>
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    {t.url ? (
                      <a href={t.url} target="_blank" rel="noopener noreferrer" class="type-body text-base-content hover:text-primary" style="font-weight:480;">
                        <span data-only="ko">{t.title.ko}</span>
                        <span data-only="en">{t.title.en}</span>
                      </a>
                    ) : (
                      <p class="type-body text-base-content" style="font-weight:480;">
                        <span data-only="ko">{t.title.ko}</span>
                        <span data-only="en">{t.title.en}</span>
                      </p>
                    )}
                    <p class="type-body-sm text-base-content/70 mt-0.5">
                      <span data-only="ko">{t.host.ko}</span>
                      <span data-only="en">{t.host.en}</span>
                      {t.students > 0 && ` · ${t.students}`}
                      <span data-only="ko">{t.students > 0 ? '명' : ''}</span>
                      <span data-only="en">{t.students > 0 ? ` students` : ''}</span>
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── CAREER ───────── -->
  <section id="career" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
    <p class="type-eyebrow text-primary mb-3">{site.career.eyebrow}</p>
    <L tag="h2" class="type-display-lg mb-8" ko={`${site.career.title.ko} (${career.length})`} en={`${site.career.title.en} (${career.length})`} />

    <div class="space-y-2">
      {career.map((w) => (
        <div class="flex items-start gap-3 py-3 px-2 -mx-2 rounded-md hover:bg-base-200/60 transition-colors border-b border-base-300/30">
          <!-- Logo slot (square) -->
          <div class="shrink-0 w-[72px] h-[72px] rounded-lg bg-white border border-base-300/60 flex items-center justify-center overflow-hidden mt-0.5">
            {w.logo ? (
              <img src={w.logo} alt="" class="max-w-[80%] max-h-[80%] object-contain" loading="lazy" />
            ) : (
              <span class="text-base-content/30 text-lg">💼</span>
            )}
          </div>

          <div class="flex-1 min-w-0 flex flex-col md:flex-row md:items-baseline gap-1 md:gap-4">
            <div class="flex flex-wrap items-center gap-2 md:contents">
              <span class="shrink-0 type-body-sm text-base-content/70 whitespace-nowrap w-fit md:w-36">
                {w.period}
              </span>
              <span class="shrink-0 pill pill-co">
                <span data-only="ko">{w.type.ko}</span>
                <span data-only="en">{w.type.en}</span>
              </span>
            </div>
            <div class="flex-1 min-w-0">
              {w.url ? (
                <a href={w.url} target="_blank" rel="noopener noreferrer" class="type-body text-base-content hover:text-primary" style="font-weight:480;">
                  <span data-only="ko">{w.company.ko}</span>
                  <span data-only="en">{w.company.en}</span>
                </a>
              ) : (
                <p class="type-body text-base-content" style="font-weight:480;">
                  <span data-only="ko">{w.company.ko}</span>
                  <span data-only="en">{w.company.en}</span>
                </p>
              )}
              {w.desc && (
                <p class="type-body-sm text-base-content/70 mt-0.5 italic">{w.desc}</p>
              )}
              <p class="type-body-sm text-base-content/70 mt-0.5">
                <span data-only="ko">{w.country.ko}</span>
                <span data-only="en">{w.country.en}{w.fundingUsd ? ` · ${w.fundingUsd} startup grant` : ''}</span>
              </p>
              {w.papers && (
                <p class="type-body-sm mt-1 leading-snug">
                  <span class="font-semibold text-primary">{w.papers.includes(' · ') ? 'Papers' : 'Paper'}: </span>
                  <span class="text-base-content/65">{w.papers}</span>
                </p>
              )}
              {w.patents && (
                <p class="type-body-sm mt-1 leading-snug">
                  <span class="font-semibold text-primary">{w.patents.includes(' · ') ? 'Patents' : 'Patent'}: </span>
                  <span class="text-base-content/65">{w.patents}</span>
                </p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Certifications (included in Career, like Books in Publications) -->
    <L tag="p" class="type-caption text-base-content/65 mb-4 mt-12" ko={`${site.honors.certifications.label.ko} (${certifications.length})`} en={`${site.honors.certifications.label.en} (${certifications.length})`} />
    <div class="flex flex-wrap gap-2">
      {certifications.map((c) => (
        <div class="cert-chip px-3 py-2 rounded-lg bg-base-200/60 border border-base-300/60">
          <p class="type-body-sm text-base-content" style="font-weight:500;">
            <span data-only="ko">{c.name.ko}</span>
            <span data-only="en">{c.name.en}</span>
          </p>
          {c.date && <p class="type-caption text-base-content/70 mt-0.5">{c.date}</p>}
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── FUNDING (scholarships / fellowships; was Honors) ───────── -->
  <section id="funding" class="pb-20 border-t border-base-300 pt-14 scroll-mt-12">
