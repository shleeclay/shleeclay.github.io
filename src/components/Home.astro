    <div class="cite-modal-panel" role="dialog" aria-modal="true" aria-label="Citation">
      <button type="button" class="cite-modal-x" data-cite-close aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <div class="cite-block">
        <div class="cite-head">
          <span class="cite-label">APA</span>
          <button type="button" class="cite-copy" data-cite-src="apa">
            <span class="cite-copy-default">
              <span data-only="ko">복사</span><span data-only="en">Copy</span>
            </span>
            <span class="cite-copy-done">
              <span data-only="ko">복사됨 ✓</span><span data-only="en">Copied ✓</span>
            </span>
          </button>
        </div>
        <p id="cite-apa" class="cite-text"></p>
      </div>
    </div>
  </div>

  <!-- Carry the current light/dark theme to upwise.co.kr via ?theme= so the
       external site opens in the matching theme. Keeps in sync on toggle. -->
  <script is:inline>
    (function () {
      const badge = document.querySelector('a.upwise-badge');
      if (!badge) return;
      const base = badge.getAttribute('href'); // clean base URL (ko or /en)
      function sync() {
        const dark = document.documentElement.getAttribute('data-theme') === 'shlee-dark';
        const sep = base.indexOf('?') >= 0 ? '&' : '?';
        badge.setAttribute('href', base + sep + 'theme=' + (dark ? 'dark' : 'light'));
      }
      sync();
      new MutationObserver(sync).observe(document.documentElement, {
        attributes: true, attributeFilter: ['data-theme'],
      });
    })();
  </script>

  <script is:inline>
    (function () {
      const modal = document.getElementById('cite-modal');
      if (!modal) return;
      const apaEl = document.getElementById('cite-apa');

      function openModal(apa) {
        apaEl.textContent = apa || '';
        modal.querySelectorAll('.cite-copy').forEach((b) => b.classList.remove('copied'));
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function closeModal() {
        modal.hidden = true;
        document.body.style.overflow = '';
      }

      // Open from any Cite button (event delegation)
      document.addEventListener('click', (e) => {
        const t = e.target.closest('.cite-toggle');
        if (t) {
          e.preventDefault();
          openModal(t.getAttribute('data-apa'));
        }
      });

      // Close on backdrop / X
      modal.querySelectorAll('[data-cite-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });

      // Copy button
      modal.querySelectorAll('.cite-copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = apaEl.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            // Fallback for non-secure contexts
            const ta = document.createElement('textarea');
            ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); } catch {}
            document.body.removeChild(ta);
          }
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1600);
        });
      });
    })();
  </script>

  <!-- Mobile: collapsible sections (header tap toggles body). Desktop unaffected. -->
  <script is:inline>
    (function () {
      const COLLAPSIBLE = ['about','education','publications','conferences','projects','patents','teaching','career','honors'];

      function wrap() {
        COLLAPSIBLE.forEach((id) => {
          const sec = document.getElementById(id);
          if (!sec || sec.dataset.collapsible) return;

          const children = Array.from(sec.children);
          // Header = leading eyebrow <p> + <h2> title(s); body = everything after.
          let i = 0;
          while (i < children.length) {
            const el = children[i];
            const tag = el.tagName.toLowerCase();
            const cls = el.getAttribute('class') || '';
            if (tag === 'h2' || cls.indexOf('type-eyebrow') !== -1) { i++; continue; }
            break;
          }
          if (i === 0 || i >= children.length) return;

          const body = document.createElement('div');
          body.className = 'section-body';
          children.slice(i).forEach((c) => body.appendChild(c));

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'section-toggle';
          btn.setAttribute('aria-expanded', 'true');
          btn.setAttribute('aria-controls', id + '-body');
          body.id = id + '-body';

          const head = document.createElement('div');
          head.className = 'section-head-inner';
          children.slice(0, i).forEach((c) => head.appendChild(c));

          const chev = document.createElement('span');
          chev.className = 'section-chevron';
          chev.setAttribute('aria-hidden', 'true');

          btn.appendChild(head);
          btn.appendChild(chev);
          sec.appendChild(btn);
          sec.appendChild(body);

          btn.addEventListener('click', () => {
            // Only act on mobile (button is non-interactive on desktop via CSS, but guard anyway)
            if (window.matchMedia('(min-width: 1024px)').matches) return;
            const collapsed = sec.classList.toggle('section-collapsed');
            btn.setAttribute('aria-expanded', String(!collapsed));
          });

          sec.dataset.collapsible = '1';
        });
      }

      // When navigating to a section via the menu, make sure it's expanded.
      function expandTarget() {
        const id = (location.hash || '').replace('#', '');
        if (!id) return;
        const sec = document.getElementById(id);
        if (sec && sec.classList.contains('section-collapsed')) {
          sec.classList.remove('section-collapsed');
          const btn = sec.querySelector('.section-toggle');
          if (btn) btn.setAttribute('aria-expanded', 'true');
        }
      }

      function start() {
        wrap();
        window.addEventListener('hashchange', expandTarget);
        // Expand on nav click even if hash doesn't change
        document.querySelectorAll('.nav-item').forEach((l) => {
          l.addEventListener('click', () => setTimeout(expandTarget, 0));
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>

  <!-- Scroll-spy: highlight current section in sidebar -->
  <script is:inline>
    (function () {
      function init() {
        const allSections = Array.from(document.querySelectorAll('section[id]'));
        const navLinks = document.querySelectorAll('.nav-item');
        if (!allSections.length || !navLinks.length) return;

        const linkById = new Map();
        navLinks.forEach((l) => {
          const href = l.getAttribute('href') || '';
          // Handles "#id", "/#id", and "/en#id" — take everything after '#'
          const hashIdx = href.indexOf('#');
          const id = hashIdx >= 0 ? href.slice(hashIdx + 1) : null;
          if (id) linkById.set(id, l);
        });

        const tracked = allSections.filter((s) => linkById.has(s.id));
        if (!tracked.length) return;

        function setActive(id) {
          navLinks.forEach((l) => l.classList.remove('active-nav-item'));
          const link = linkById.get(id);
          if (link) link.classList.add('active-nav-item');
        }

        function update() {
          const nearBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
          if (nearBottom) {
            setActive(tracked[tracked.length - 1].id);
            return;
          }

          const trigger = window.scrollY + window.innerHeight * 0.30;
          let current = tracked[0];
          for (const s of tracked) {
            const top = s.getBoundingClientRect().top + window.scrollY;
            if (top <= trigger) {
              current = s;
            } else {
              break;
            }
          }
          if (current) setActive(current.id);
        }

        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => { update(); ticking = false; });
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', update);
        update();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
