---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";
import L from "./L.astro";
const { lang = "ko", sideBarActiveItemID } = Astro.props;
const homeHref = lang === "en" ? "/en" : "/";
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-4 pt-6 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col border-r border-base-300">
    <!-- Brand block -->
    <a href={homeHref} class="group block mb-4">
      <div class="flex flex-col items-start gap-1 transition-transform duration-300 group-hover:translate-x-1">
        <div class="flex items-baseline gap-2">
          <span class="text-2xl" aria-hidden="true">🌿</span>
          <L tag="h1" class="type-headline" ko="이승현" en="Seunghyeon Lee" />
        </div>
        <L tag="span" class="text-sm text-base-content/70" ko="Clay Lee" en="Clay Lee" />
        <span class="text-[10px] text-base-content/55 tracking-widest uppercase mt-2">Research Portfolio</span>
      </div>
    </a>

    <!-- Tagline -->
    <L
      tag="p"
      class="text-sm text-base-content/70 leading-relaxed px-1 mb-6 mt-3"
      ko="공간 데이터로 산림·도시 생태계의 구조를 읽습니다."
      en="Reading the structure of forest and urban ecosystems with spatial data."
    />

    <div class="divider my-0 opacity-30"></div>

    <SideBarMenu lang={lang} sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter lang={lang} />
  </aside>
</div>
