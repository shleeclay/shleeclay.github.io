---
// 공용 figure 캐러셀 라이트박스. 페이지당 1회 포함.
// 트리거: 클래스 .fig-open + data-figs(JSON [{src,caption}]) + data-title 를 가진 요소.
// 좌우 버튼 / 마우스 휠(PC) / 키보드 ←→ / 터치 스와이프 / 도트 내비. 캡션 앞에 "Figure N." 자동 라벨.
---

<div id="figcz" aria-modal="true" role="dialog" aria-label="Figure viewer">
  <button class="figcz-x" aria-label="닫기 / Close">&times;</button>
  <span class="figcz-title" id="figcz-title"></span>
  <div class="figcz-stage">
    <div class="figcz-imgwrap">
      <button class="figcz-nav prev" aria-label="이전 / Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
      <img id="figcz-img" src="" alt="" />
      <button class="figcz-nav next" aria-label="다음 / Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
    </div>
    <p class="figcz-cap" id="figcz-cap"></p>
    <p class="figcz-count" id="figcz-count"></p>
    <div class="figcz-dots" id="figcz-dots"></div>
  </div>
</div>

<style>
  #figcz { position:fixed; inset:0; background:rgba(7,14,10,.9); display:none; z-index:80;
    align-items:center; justify-content:center; padding:24px; }
  #figcz.on { display:flex; }
  .figcz-stage { max-width:1000px; width:100%; display:flex; flex-direction:column; align-items:center; }
  .figcz-imgwrap { position:relative; width:100%; display:flex; align-items:center; justify-content:center; }
  #figcz-img { max-width:100%; max-height:74vh; border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,.5);
    user-select:none; -webkit-user-drag:none; }
  .figcz-cap { color:#e6ece7; font-size:14px; line-height:1.5; margin:16px auto 0; text-align:center; min-height:1.4em; max-width:760px; }
  .figcz-cap b { color:#fff; }
  .figcz-count { color:#9fb0a6; font-size:12px; margin-top:6px; letter-spacing:.05em; }
  .figcz-nav { position:absolute; top:50%; transform:translateY(-50%); background:rgba(20,30,24,.55);
    border:1px solid rgba(255,255,255,.45); color:#fff; width:52px; height:52px; border-radius:999px;
    padding:0; cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:.18s; z-index:5; backdrop-filter:blur(2px); box-shadow:0 2px 12px rgba(0,0,0,.4); }
  .figcz-nav svg { width:24px; height:24px; display:block; }
  .figcz-nav:hover { background:rgba(255,255,255,.92); color:#142018; transform:translateY(-50%) scale(1.06); }
  .figcz-nav.prev { left:-66px; } .figcz-nav.next { right:-66px; }
  @media(max-width:1140px){ .figcz-nav.prev{left:6px;} .figcz-nav.next{right:6px;} }
  .figcz-dots { display:flex; gap:7px; margin-top:14px; flex-wrap:wrap; justify-content:center; }
  .figcz-dots i { width:7px; height:7px; border-radius:999px; background:rgba(255,255,255,.3); display:block; cursor:pointer; }
  .figcz-dots i.on { background:#fff; }
  .figcz-x { position:absolute; top:18px; right:22px; background:none; border:none; color:#fff; font-size:30px; cursor:pointer; line-height:1; z-index:6; }
  .figcz-title { position:absolute; top:18px; left:50%; transform:translateX(-50%); color:#cdd8d0;
    font-size:13px; max-width:56vw; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
</style>

<script is:inline>
  (function () {
    const cz = document.getElementById('figcz');
    if (!cz) return;
    const img = document.getElementById('figcz-img');
    const cap = document.getElementById('figcz-cap');
    const count = document.getElementById('figcz-count');
    const dots = document.getElementById('figcz-dots');
    const titleEl = document.getElementById('figcz-title');
    const prevB = cz.querySelector('.figcz-nav.prev');
    const nextB = cz.querySelector('.figcz-nav.next');
    let figs = [], idx = 0;
    const preloaded = new Set();

    // 인접 figure 미리 받기(prefetch) → 좌우 이동 시 깜빡임 제거
    function prefetch(j) {
      if (!figs.length) return;
      const k = ((j % figs.length) + figs.length) % figs.length;
      const src = figs[k] && figs[k].src;
      if (src && !preloaded.has(src)) { preloaded.add(src); const im = new Image(); im.src = src; }
    }

    // 파일명에서 라벨 도출: fig1→"Figure 1", figS1→"Figure S1", ga→"Graphical Abstract"
    function labelFromSrc(src) {
      const name = (src.split('/').pop() || '').replace(/\.webp$/i, '');
      if (name === 'ga') return 'Graphical Abstract';
      const m = name.match(/^fig(S?\d+)$/i);
      return m ? 'Figure ' + m[1].toUpperCase() : '';
    }

    function render() {
      const f = figs[idx];
      img.src = f.src; img.alt = f.caption || '';
      cap.innerHTML = '';
      const label = labelFromSrc(f.src);
      if (label) {
        const b = document.createElement('b');
        b.textContent = f.caption ? label + '. ' : label;
        cap.appendChild(b);
      }
      if (f.caption) cap.appendChild(document.createTextNode(f.caption));
      count.textContent = (idx + 1) + ' / ' + figs.length;
      prefetch(idx + 1); prefetch(idx - 1);  // 다음·이전 figure 미리 로드
      dots.innerHTML = '';
      figs.forEach((_, i) => {
        const d = document.createElement('i');
        if (i === idx) d.className = 'on';
        d.addEventListener('click', () => { idx = i; render(); });
        dots.appendChild(d);
      });
    }
    function open(data, title) {
      figs = data; idx = 0; titleEl.textContent = title || '';
      cz.classList.add('on'); render();
    }
    function close() { cz.classList.remove('on'); img.src = ''; }
    function go(n) { if (!figs.length) return; idx = (idx + n + figs.length) % figs.length; render(); }

    document.querySelectorAll('.fig-open').forEach((el) => {
      let data; try { data = JSON.parse(el.getAttribute('data-figs') || '[]'); } catch (e) { data = []; }
      if (!data.length) return;
      const title = el.getAttribute('data-title') || '';
      el.addEventListener('click', (e) => { e.preventDefault(); open(data, title); });
      el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(data, title); } });
    });
    prevB.addEventListener('click', () => go(-1));
    nextB.addEventListener('click', () => go(1));
    cz.querySelector('.figcz-x').addEventListener('click', close);
    cz.addEventListener('click', (e) => { if (e.target === cz) close(); });
    document.addEventListener('keydown', (e) => {
      if (!cz.classList.contains('on')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
    let wheelLock = false;
    cz.addEventListener('wheel', (e) => {
      if (!cz.classList.contains('on')) return;
      e.preventDefault();
      if (wheelLock) return;
      const d = e.deltaY || e.deltaX;
      if (Math.abs(d) < 8) return;
      go(d > 0 ? 1 : -1);
      wheelLock = true;
      setTimeout(() => { wheelLock = false; }, 260);
    }, { passive: false });
    let x0 = null;
    img.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    img.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
      x0 = null;
    }, { passive: true });
  })();
</script>
